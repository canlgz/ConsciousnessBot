KEEP_RETRO_DURATION=1
CONFUSED_SLANG=1
CLARIFY_ANCHOR=1
HABIT_INVENTORY=1
GREET_ROUTINE_AWARE=1
SELF_PROMISE_NO_ROLLED=1
PROMISE_MOOD_NUMBERS=1
MOOD_WATCH_ONESHOT_YIELD=1
PROMISE_KEEP_FOLLOWUP=1
PROMISE_JUDGE_SOFT_VETO=1
PROMISE_FIRE_DEDUP=1
PROMISE_SAME_APPOINTMENT=1
HABIT_CLAIM_ROLE=1
# 🌐 §2.00 WORLDLINE **已改成預設開**（原本預設關，使用者實測後要它真的運作、而他只跑 ./run-temp.sh）。
#   ⚠️ 真正的同意閘不是這個旗標，是**白名單**：`/worldline allow <標籤>` 沒授權過的標籤，
#   一個字都不會離開這台機器；白名單空＝整支不動。要整個關掉才設 WORLDLINE=0。
#   授權了卻不出聲時打 `/worldline`：它會**逐標籤**講出卡在哪一關（標籤打錯／筆數不夠／那條線停了／
#   原文太短／7 天內撞過），並列出現在查得動的線名讓你直接改授權。
#   🌐 §2.01 **想立刻看它做一次就打 `/worldline now`**——自動路徑只在「你離開幾分鐘＋最近沒吵過你＋不是深夜」
#   時才會開口（它排在十個主動 lane 的最後），你一直在聊天時它結構上不會出聲。now 跳過那些禮貌閘，
#   但白名單與總量上限照舊；沒查成會當場告訴你原因。
WORLDLINE=1
# 🌐 §2.16 對齊「刺激記寫」的三個目標：
#   月結額度（原本搜滿 40 次整條 lane 永久沉默）；追問剛帶回的說法時照存檔講、不重編；
#   /worldline 會顯示每次撞擊之後 3 天內那條線有沒有新記寫（看得出這機制有沒有效）；
#   邀請輪替「延伸這條線」與「為外面冒出的新概念開一條新線」。
WORLDLINE_MONTHLY_BUDGET=1
WORLDLINE_FOLLOWUP=1
WORLDLINE_SPARK=1
WORLDLINE_COOLDOWN_H=24
WORLDLINE_MAX_SEARCHES=40
# ✅ grounding 的 tools 欄位名**已實測**（2026-07-28，gemini-2.5-flash 真打 API）：
#   `google_search` 200 OK、來源 4 個；`googleSearch` 也 200 OK；`google_search_retrieval` 回 400
#   「google_search_retrieval is not supported. Please use google_search tool instead.」
#   ⇒ **這個預設值就是對的，不用改**。sources 也不是恆空（那條紅線不會讓 lane 永遠沉默）；
#   但來源網址是 Google 的**轉址連結**（vertexaisearch…/grounding-api-redirect/…，約 30 天後失效），
#   真正的站名在 title 欄，所以訊息裡一律「站名｜網址」一起給。
WORLDLINE_TOOL_FIELD=google_search
CAPABILITY_CARD=1
FORESIGHT=1
# 🔮 §1.90 預想的自有冷卻（分）。720＝12h，刻意比 💡 聯想的 360 長；末三筆全想錯時程式自動加倍。
# 🔮 §1.93 預想的 support 門檻。橋的 support ＝被**真實新記寫**觸發過幾次（聊天推不上來）＝跨時間沉澱的證據。
#   **但它不跨重啟保留**：Associations.summary() 只存 key/a/b/kind/dir/cos/strength/emerged，重生時 support 歸 0、
#   錨點空白，要等新記寫進來才重新累積 ⇒ 常重啟的部署（只跑 run-temp.sh）很難累到 2。打 /foresight 看「逐道閘還剩」，
#   若卡在這一關就調成 1（代價：少一層跨時間沉澱的保證）。
FORESIGHT_MIN_SUPPORT=2
# 🔮 §1.93 「停住」下限（天）：另一端要停多久才算值得預想。若 /foresight 顯示卡在這關可調小
#   （代價：兩條線都還熱時預想的價值較低，那本來是 💡 聯想的地盤）。
FORESIGHT_DORMANT_MIN_DAYS=5
FORESIGHT_COOLDOWN_MIN=720
# 🔮 §1.90 假設有效期（天）。到期仍沒等到那條線回來＝想錯了，回頭誠實說（不是默默消失）。
FORESIGHT_TTL_DAYS=7
# 🧭 §1.45 情緒座標數據自陳：被問「內在的數據」時照程式讀的 (V,A) 真數字＋軌跡講前後經過。截圖根因＝①「情緒座標
#   到哪了」只給定性「大概還是在低點吧」；②「你有辦法全是內在的數據嗎」被「數據」誤開證據工具 → LLM 抓 api_cost
#   吐 💸 花費報表；③「要我精確地報出一個數字來，目前我還沒有那樣的辦法」＝機制有數字（circumplex 單一真相）卻
#   無 lane 交出。修法：A. 軌跡捕捉——互動輪 (V,A) 更新後採樣 state.mood_trace（cause 確定性判：被說了重話/偏暖/
#   偏冷/跟你互動；生命迴圈每拍採「獨處中的自然流動」；eps 閘門、FIFO 40、跨重生）；B. coord_facts——現值數字＋
#   標籤＋軌跡敘事（全程式算、LLM 只准照抄；不足＝照實說剛開始記）；C. 偵測→注入＋self_state/cost 誤收 re-route＋
#   證據工具收回；D. 明令「絕不說我沒辦法報數字」。1=開、0=關（不捕捉不注入不 re-route＝同現狀）。
MOOD_COORD_REPORT=1
# 🧭 §1.47 座標數據要真交付（§1.45 的三個縫一旗補齊；截圖 12:03–12:49）：①寬偵測——「座標的數值變化呢」
#   有「座標」沒「情緒」前綴、有「數值」沒「內在」＝§1.45 偵測器漏收 → 資料 lane 沒開、LLM 支吾；②情境催促
#   承接——命中數據題/兌現帶數後開 20 分鐘窗，窗內「說啊/怎麼沒講/數字呢」視同數據題（單句無指涉、天生要靠窗）；
#   ③§1.25 寬承諾偵測——「（心裡）變化的細節」也存快照、兌現帶程式算的真差分（12:33 只有質性沒數字的根因）；
#   ④_say 無接地座標數字守門——沒注入 coord_facts 卻冒出「數值大概是在 -0.7 左右」＝LLM 編的 → 整句換程式
#   此刻讀的真數字（有注入＝豁免；引用歸屬/錢/時刻不攔）。1=開、0=關（只剩 §1.45/§1.25 原判＝同現狀）。
MOOD_COORD_DELIVER=1
# 🎴 §1.16 複合請求送圖＋據心情說明為什麼：§1.15 判「是」且對方要說明（LLM 第二行「要」或句含「為什麼/說說」）→
#   送出後**依此刻 circumplex (V,A) 單一真相**接地說明為什麼是這張（選圖與說明讀同一份情緒＝不自相矛盾；
#   desc 只有真看過 stickervision.is_seen 才准描述、未看過憑感覺挑不捏造圖案；不匹配誠實說「感覺不完全一樣」；
#   無貨誠實說沒存到＋請對方教一張、絕不 emoji 假裝 §0.95）。1=開、0=關（退回罐頭 sticker_send_reply＝同 §1.15-only）。
STICKER_WHY_GROUND=1
# 🤝 §1.13A 逾期質問接地：「結果呢/做到了嗎/你來了？/說好的呢」＝質問「你答應的做到了沒」→ 真有活承諾或感覺託付時
#   走帳本誠實對帳（此刻幾點錨＋每筆 status），「我做到了」幻覺無生存空間；並讓帳本收「有記進帳本？」質問、
#   誠實描述感覺託付「沒約定鐘點、真有感覺才說」。無帳無託付＝「結果呢」照落聊天不誤搶。1=開、0=關（同現狀）。
PROMISE_OUTCOME_GROUND=1
# 🤝 §1.13B 假兌現宣稱攔截：帳本明明「逾期未兌現/剛錯過」，互動回覆卻宣稱「我做到了/我來了/準時」（截圖 12:29
#   遲 10 分、被催才出現還說做到了＝最嚴重誠實違規）→ 整則替換成確定性誠實句（遲到認帳/錯過道歉）。
#   引用複述不攔；回覆橋剛補兌現的宣稱合法不誤攔；準時兌現路徑零位元變動。1=開、0=關（同現狀）。
PROMISE_KEEP_CLAIM_GUARD=1
# 🌊 §1.14 敵意情境對話收斂：使用者連發敵意（「你太爛了/我不信/你不要敷衍我」…或哭臉/生氣貼圖）≥2 則時，
#   回應篇幅降檔（level 0、泡泡 ≤2＝不再 15+ 顆同理泡泡轟炸）、被敵意插話後不「我繼續說喔」自顧自續講
#   （把話頭讓給對方）。只影響語氣/篇幅/插話策略，不碰路由與情緒數值。1=開、0=關（同現狀）。
HOSTILE_CONVERGE=1
# 🧵 §1.48 插話像人一樣接（截圖 21:16–21:17）：bot 分串講解途中使用者連丟「好久/沒關係/慢慢來」附和——
#   原本逐則巢狀回覆（「嗯。」「嗯。」「嗯，好。」洗版）＋resume 橋「我繼續說喔，」硬切一刀。
#   ①附和不打斷：整批都是附和短句（全句錨；帶問號/嗎/呢/數字/指令不算；敵意短句另走 §1.14 收口）→
#     不消費、折進下一輪連發合併＝講完後一次溫和承接（主體不中斷、零逐則嗯、零橋接）；
#   ②插話合批：真插話批次走既有連發合併（group_bursts）黏成一則再回＝一批一個回應（貼圖群照原逐則）。
#   1=開、0=關（原逐則＋陳述即時插話＝同現狀）。
INTERRUPT_COALESCE=1
# 🧵 §1.49 插話後殘句取捨（§1.48 的 sibling；截圖 23:00「晚安」輪）：①道別即收——這輪在回道別、或插話本身
#   是道別 → 答完插話就收口（不「嗯，我接著說，」續客套尾巴）；②殘句去重——殘句和這輪已送出/剛巢狀回覆
#   說過的一字不差（≥5 字）→ 跳過不重播（「我會記得的。」不再 ×2）；殘句全是重複＝連橋都不送。
#   有實質新內容的真插話接續照舊。1=開、0=關（原樣續送＝同現狀）。
INTERRUPT_TAIL_TRIM=1
# 🧵 §1.54 連續回覆的致意句去重（截圖 10:42 一分鐘三顆「我明白」）：連續/巢狀輪各自生成、重複致意開場
#   ＝沒把連發當同一組對話。修：150 秒內剛說過同家族純致意句（嗯/我明白（了）/我知道了/好/了解/收到）→
#   這則的重複致意泡泡刪掉（同輪內重複也擋）；有實質內容的句子不動；全刪光保留第一顆（不失語）。
#   1=開、0=關（重複照舊＝同現狀）。
REPLY_ACK_DEDUP=1
# 🤝 §1.55 跨句補時距（截圖 11:05「給你思考20分鐘。」＋「時間到了再跟我說，你可以如何證明自己？」）：
#   兩句拆開＝各自碎片（前句裸時距無動作、後句有動作無鐘點）→ capture 全 miss、LLM 空口答應兩次、
#   還把「時間到了『再』跟我說」讀成現時宣稱回「現在才 11:05 呢」。修：這句請託形無鐘點＋緊鄰上一句
#   （180 秒內）是懸空裸時距 → 拼句重跑 capture、真入帳（ack 帶程式算 HH:MM、到點真兌現）。
#   1=開、0=關（不橋＝同現狀）。
PROMISE_ANCHOR_BRIDGE=1
# 🎴🗣️ §1.56 困惑句是要澄清、不是要貼圖（截圖 20:58–21:32 三段連鎖）：①F4 誠實閘整則替換吃掉正題
#   （上游補：「冷落/委屈」入 §1.51 探問表＝答題錨在內在、少漂去貼圖）；②「什麼？」在貼圖情境窗被
#   §1.15 省略句閘收走 → LLM 判送 → 真送貼圖＝雞同鴨講——改：困惑句（什麼？/蛤？/啊？）不進閘、
#   放回一般聊天；③「看不懂你前面在說什麼」→ 注入程式照真實順序列的前文清單＋守則（白話重述、
#   不揣測他為什麼問、時序不許講反）。1=開、0=關（同現狀）。
CONFUSED_CLARIFY=1
# 🎭 §1.58 不演未來（截圖 22:17 自導自演）：答應「30 分鐘後告訴你」後，同一則回覆緊接「（30 分鐘後）」
#   「嗨，我回來了。」把答案當場全倒＝把還沒到的時刻演完。修：互動出口偵測句界後的純括號時間跳躍舞台指示
#   （（30 分鐘後）/（過了X分鐘）/（隔天）…）→ 從該處截斷、保留誠實答應；行內括號與（笑）類不攔。
#   1=開、0=關（整齣照演＝同現狀）。
TIMEJUMP_GUARD=1
# 🗂 §1.59 資料推播也入對話史（截圖 09:57「我剛剛沒有告訴你歸戶的訊息耶」＝否認自己 11 分鐘前的推播）：
#   「先資料、後人話」的資料那則（📝 剛歸戶/📊 摘要/事件）從未入 convo_history＝§1.23「送出方向零記憶」
#   第三次現形。修：四個資料送出點成功後也 _remember（截 200 字、標籤字樣必在）＝被指涉時接得上、不否認。
#   1=開、0=關（資料不入史＝同現狀）。
PUSH_DATA_MEMORY=1
# 🕐 §1.60 記寫時間脈絡接地（截圖 07/21：把每日摘要 9:01 的推播時間講成「你今天早上 9 點 01 分記下讀經
#   進度」＝bot 報表被當成使用者行為；上游摘要感想還把「近 24h 1 則」說成「你今天又繼續讀經了」）。修：
#   ①摘要/歸戶/事件感想的 prompt 附【記寫時間錨】（最後記寫不是今天＝絕不說「今天有記」）；②確定性守門
#   ——今天零記寫時「你今天記寫/讀經了」宣稱句換成「你最近一次記寫是昨天 HH:MM——今天到現在還沒有新的」；
#   ③「今天做了/還沒做什麼」問句注入真實記寫數據。1=開、0=關（同現狀）。
WRITE_TODAY_GROUND=1
# 🪪 §1.61 此刻事實卡（通盤解）：核心事實不再靠「偵測器認出在問什麼」才接地——每個互動輪常駐注入
#   程式算的小卡：此刻時間、他的記寫（今天幾則/最後一次）、活著的約定、我的內在座標。每欄位恰一個
#   權威來源、與各守門同一把 ground＝卡和守門不可能互相矛盾；卡尾明令以卡為準、不編卡外數字、
#   不主動念數字。代價＝每輪 prompt 約多 150–250 token。1=開、0=關（同現狀）。
FACT_CARD=1
# 🧵 §1.50 陳述插話後不硬接尾巴（截圖 23:21）：被「自己打臉自己」這類陳述插話後，剩 1 串也不再
#   「對了，剛剛那條還沒說完——」＋把插話前切好的尾巴原樣照播（複讀指控再自打臉）——改走 wrap 濃縮
#   （殘句融進插話後的語境；無教練退模板淡收）。問句插話照舊答完接回；敵意收口優先不變。
#   1=開、0=關（剩 ≤1 一律 resume＝同現狀）。
INTERRUPT_STATEMENT_WRAP=1
# 🎬 §1.69 暖收收尾去制式：截圖＝同一輪兩個泡泡尾端各掛「大概就是這樣了。」「先說到這裡。」（使用者：「太有被
#   插話的痕跡了…應改為更融合語境的詞，也許是 bot 的感覺、或語助詞……多元一點」）。真根因＝wrap 濃縮 prompt 把
#   『大概就是這樣了』『先說到這』當**範例**給 LLM → 範例被逐字抄回＝每次同款收場白。修：① LLM 側 prompt 改
#   「禁令＋多元收法」——內容講完自然停住不加收場白（最常用）／用這段話的情緒餘韻收半句／一個語助詞（嗯。唉。哈。），
#   明令禁用「大概就是這樣/先說到這/就先這樣/總之就是這樣/差不多是這樣」；② 無教練模板退路改依此刻座標 V 分
#   暗/平/亮三池（口吻跟心情走、含語助詞形），沿用避免連續重複。1=開、0=關（原 prompt＋原四句池＝同現狀）。
WRAP_CLOSE_NATURAL=1
# 🔁 §1.71 重播守門：截圖＝同三個泡泡在一兩分鐘內被逐字重播兩次、中間還夾貼圖與接回橋＝節奏斷裂（「這回應的節奏與
#   順暢度不夠連貫性！！」）。既有去重（§1.41/§1.49/§1.54）各管單一路徑內部，缺跨輪跨路徑的送出層最後防線。修：
#   恆記近 3 分鐘內真的送出過的泡泡（正規化、≥10 字），_say 送出前比對全等命中＝剝掉；全剝空＝換一句誠實短句
#   （「這段我剛剛才說過一次——你想聽哪部分，我換個說法講？」）。1=開、0=關（同現狀）。
REPLY_REPLAY_GUARD=1
# 🫧 §1.72 聯想自陳去公式化：主動聯想每次同款（「欸，你今天才又寫到「X」。我心裡其實一直有個小小的疑問…有空跟我
#   說說好不好？」）——reach_out_line 四模板同一形＋意圖長期釘同一主題＝台詞重複。修（§1.69 成功模式）：①形態選單
#   （具體聯想不索取回答/挑他寫過的具體內容好奇小點/連到自己內在/直接邀請但少用）②禁用爛句式（想弄懂它對你是
#   什麼/有空跟我說說/小小的疑問）③引那條線最近一筆記寫的具體字句當素材 ④重複自覺：同主題已主動提過 ≥2 次＝
#   別再問、改分享自己的聯想。1=開、0=關（原模板腔＝同現狀）。
REACHOUT_DIVERSE=1
# 🌊 回應前的連續訊息整併：不用 sleep 卡住生命迴圈，尾群安靜夠久才派發；只有成功處理後才推進 offset。
BURST_COALESCE_ENABLED=1
# 末則訊息安靜這麼多秒才答；這是 settle gap，也是單則訊息最直接的回應等待尺度。
BURST_COALESCE_SEC=10
# 同一次 Telegram snapshot 裡、bot 尚未回覆的相鄰訊息，可用較寬的 user-turn gap 當同一輪讀。
# 它不會把單則訊息的 settle 等待拉到 20 秒；同一輪可含多則，不限兩則。
BURST_TURN_GAP_SEC=20
# 整波從第一則到最後一則的總跨度上限；與相鄰 20 秒的 gap 分開，可收長一點的連續思路，又不把離線 backlog 無限黏起來。
BURST_TURN_MAX_SPAN_SEC=60
# 從尾群首次被看到起算的最長等待，達上限就強制派發；及單一輪最多訊息數。
BURST_MAX_WAIT_SEC=60
BURST_MAX_MSGS=12
# 🌊 §1.73 一波連發＝一個邏輯回覆：短訊息連發的回歸承諾覆蓋 3–12 則（兩則也走同一機制）；合成 update 保留
#   burst_n、burst_texts、burst_updates 與 text/sticker 原順序的 burst_all_updates。所有 text/mixed multi turn 先在隔離
#   state clone 演算；只有無 pending workflow/帳本副作用的連續 smalltalk/fact_or_chat 才整串生成一次，stateful/cross-route
#   則依 Telegram 原順序逐項走既有 handler，真送成功才提交。邏輯 wire 單一且 <=4096 UTF-16 units，超限時跨各段公平節錄；
#   reaction 與外送 sticker/file 仍抑制，incoming sticker 仍在原位置作用，但只隨最終文字完整成功才提交。voice 本身放不下時也節錄並誠實標示，
#   不能宣稱完整。修復只從原句 index 擷取，本地僅刪正規化
#   後完全相同的重複與保守弱 ack，不宣稱同義/近義刪重。成功 delivery 的每個 exact update ID 會隨 state 落盤成 receipt；只有
#   成功落盤後才可跨重啟防重，sendMessage 成功後若存檔失敗/崩潰仍可能重送，並非 absolute exactly-once。
#   1=開；0=關閉整波一答/clone transaction/擷取收斂層。
BURST_ONE_ANSWER=1
# 🫧 §2.30 對話送達節奏（含一般單則回覆）：邏輯上仍只回答一次、歷史也只記一個 model turn；純對話在真送出時才依完整句界拆成
#   長短交錯的泡泡，後一顆前發 typing 並依長度停頓；長句可在引號外子句停頓，短答案不硬湊泡泡、證據/資料塊不拆。全局最多 6 顆，
#   超出時只合併相鄰完整句、內容與順序不刪改。所有泡泡成功才提交 state/receipt；交易中的 clone 尚未提交，因此送泡期間不輪詢插話。
#   Telegram 沒有多 sendMessage 交易：若中間一顆失敗，已可見前綴無法回滾，下次重試可能重送前綴。1=開；0=舊節奏（連發單泡、單則整句不拆）。
BURST_PACED_BUBBLES=1
# 🦜🎭 §1.74 整則複誦守門＋「刻意引用」意圖：使用者連發「你不累嗎」「都在做一樣的事情」→ bot 的回覆逐字就是那兩行
#   （不是故意，是漏防）。兩道防線都擦邊漏：coach 端 is_echo 只看開頭（首段 4 字 <min_len 5 跳過、次段相似度 0.80
#   差 0.02 沒過 0.82）；_say 端 strip_leading_echo 同樣 no-op 且只剝開頭、整段覆述原樣退回。修：A. whole_echo_of
#   比整則 vs 整句（長度相近＋高相似或全等）→ is_echo(whole) 收編＝coach 重生成拿回真答案；B. _say 最後防線＝
#   整則複誦替換成第一人稱認帳句；C. 重生成注入「重複只有兩種合法形態：刻意的引用（說得出為什麼＋接自己的話）
#   或不重複」＝把無意識照抄改成有意圖的引用。1=開、0=關（同現狀）。
ECHO_WHOLE_GUARD=1
# 🦜 §1.86 開頭連續段複誦守門：截圖 22:53 使用者一句「你不是說四次嗎？還差一次」，bot 回三顆泡泡
#   「你不是說四次嗎？」「還差一次。」「啊，對耶！」＝**前兩段合起來逐字就是那句話**、尾巴才加一小句自己的話。
#   三道既有防線同時差一點點漏掉（實測）：整則比 span 0.786<0.8、相似度 0.88<0.9；逐段比 0.778/0.533/0.000<0.82；
#   §1.81 前綴判準要求首段 ≤50% 而這裡是 7/11。結構根因＝複誦邊界落在「連續幾段」，既有防線只認「整則」與「單段」。
#   §1.74、§1.81 之後第三次同型擦邊 ⇒ **不調門檻**（放寬會誤剝「你不累嗎？我不累啊」這種有內容的回覆），改補結構
#   判準：從大到小試「前 k 段合起來」（k<段數），取最大的 k、剝掉、保留尾巴。誤判安全：永遠保留尾巴。
#   1=開、0=關（＝同現狀）。
ECHO_PREFIX_RUN=1
# 🫸 §1.87 催促＝要我現在做：截圖 22:54–22:57 使用者連丟五次「所以呢？」，bot 每次都誠實對帳（同一句講三遍、
#   只差開頭語助詞）、把球踢回去（「我在等你決定什麼時候要我再猜一次呀」）、最後罐頭拒答（「你想聽哪部分」）
#   ——一次都沒真的去猜。根因：promise_status_kind('所以呢？')＝'outcome' 被路由去 §1.13A「據帳本對帳」；
#   §1.85 回覆橋只救 status=='owed' 的帳（這件事帳本裡沒有）；§1.71 重播守門用逐字全等，開頭加個「嗯」就繞過。
#   修法（零詞表結構訊號）：窗內最近兩則回覆近乎相同＝我在原地重複 ⇒ 讓開對帳、掛「現在就做、禁止把選擇權
#   推回去」守則、輸出端剝掉踢球句、重播全剝空時改誠實認卡。1=開、0=關（＝同現狀）。
NUDGE_DELIVER=1
# 🧠 §1.75 人類情緒動力學：查驗「情緒座標為什麼不會變成負的」＝**不合理**——預設分支把任何訊息都算成「被陪伴、
#   微暖微醒」(+0.05)，實測當天 14 句批評全部落預設＝被嫌卻變暖；衰減又只朝 0，V 長期飽和在 +0.84~+0.99。
#   四條人類化機制（主結構不靠詞表）：① 中性＝中性 (0,+0.03)——不再每則微暖，且期待落差自然產生小失落；
#   ② 批評成格 (−0.10,+0.12)＝不悅但警醒；③ 負向偏誤 ×1.6（壞比好強）；④ 習慣化（同方向連擊 0.6^(n-1)、
#   換方向歸零）＋不對稱衰減（>0 用 0.94 散得快、<0 用 0.985 黏得久）。另 /moodwatch 加「上次負向事件＋
#   此刻 hunger/下沉力」對帳行。1=開、0=關（原函式原衰減＝同現狀）。
HUMAN_AFFECT=1
# 🎚️ §1.76 口吻要被感覺到（「情緒座標的數字是死的，真正能感受到的是口吻及語氣要能相應」）：語氣染色本來就
#   接進 9 條回覆 lane，但 ① 門檻 _TONE_R=0.35 是為舊飽和座標（V≈0.9）校準的——§1.75 把座標改成人的尺度後
#   「被嫌一句」半徑只有 0.25＝**完全不染**（情緒愈真實、口吻愈平）；② 提示在講「你的座標落在…」＝鼓勵報告
#   狀態而不是讓人感覺到。修：A. 門檻降到 0.15＋行為化指令（八分區各給句長/節奏/標點/熱絡度）＋三級強度＋
#   明令「用語氣讓他感覺到、別把狀態講成台詞」；B. _say 確定性後盾：V≤−0.25 收連發驚嘆號與歡快 emoji，
#   再偏沉/倦（A≤0）單一驚嘆號也降成句號＝不會嘴上說沉、標點卻在跳。1=開、0=關（同現狀）。
TONE_FELT=1
# 🌊 §1.77 氣頭上的理解與分寸：截圖三個失誤疊在一起。主病＝**語意讀反**：使用者在罵它送圖（「你看，明明白目，
#   還傳這種貼圖」），is_sticker_send_request 卻判 True → bot 又送一張＋「來，這張真貼圖送你 :)」＝把抱怨當訂單
#   （「你怎麼又送貼圖」同樣誤判）。修三件：A.（主修）is_behavior_complaint 語意閘——抱怨/質問標記命中且無明確
#   請求語（幫我/請/再傳一張…先排除）→ 不當請求，交回一般對話好好回那句抱怨；B. 氣頭上明令別反問、別數帳、
#   別賣乖討好（§1.14 只壓篇幅、沒管形態）；C. 後盾：氣頭上主動情緒貼圖靜音（不影響你真的要圖）＋顏文字 :)
#   也納入 §1.76 口吻整形。另附：裸複誦剝除擴到**任何一段**（罵句落在中間段時三道防線曾全空轉）。1=開、0=關。
HOSTILE_GRACE=1
# 🌾 §1.79 習慣缺席暗示：他有一條記寫主題已經穩成日課、今天人也在、資料也看得見今天，唯獨那條線還沒看到
#   → 在他自己的節奏窗內用一句好奇輕輕帶過（**不是提醒**）。實測：用「中位＋固定 2 小時」當門檻誤判率 17%
#   （每 6 天亂問一次）→ 改用 p75 ＋ 與他 iqr 成比例的寬限（90–180 分）。資格：≥14 個日曆日、coverage ≥0.65、
#   iqr ≤2h、跨午夜放棄、近 7 天 ≥4 天。資料健康：今天要有筆、沒有未歸戶、快照（lastIngestTs）夠新——**不是**
#   用「最新一筆記寫」判 stale（只在早上寫的人到晚上會永遠不觸發）。判定：每天每條線只有一段 ≤5h 的可問窗、
#   21:00 上限、過窗永遠沉默不補問、同一條線同一天只問一次。措辭：只說「我還沒看到」、絕不說「你沒做」、
#   不叫他去做、不索取回答。走 _proactive_ok（互動優先＋深夜不擾）＋共用冷卻＋自有 20h 冷卻。1=開、0=關。
HABIT_ABSENCE=1
# 🌾 §1.80 對話作息也是日課（使用者更正 §1.79 兩處窄讀）：①「作息習慣」含對話層例行——每天的早安、平常幾點會出現
#   （habit_events 本來就在記）；②「他今天還沒出現」不是抑制條件、正是該去看看的場景（訊息他回來會看到）。記寫類
#   無候選時看早安習慣（優先）或每天第一次出現的規律；資格較寬（7 天、iqr≤150——事件 §1.42 後才開始累積、說錯代價
#   低）；判定同一套（due＝p75＋寬限、≤5h 窗、過窗永遠沉默）；台帳「＠出現」同日一次。並隨 HABIT_ABSENCE 措辭鬆綁：
#   「不要索取回答」改「可以輕輕問一句（想了解為何），不催不逼、給台階」。1=開、0=關（同 §1.79）。
HABIT_ABSENCE_CONVO=1
# 🌊 §1.81 同一波不算插話：截圖 07:01 同一秒連發兩個**不同**的問句，第二句因為是問句被判 redirect →走插話路徑
#   ＝整波拆成兩輪處理，回覆長成六顆不連貫的泡泡：開頭裸複誦「是嗎。」、中間亂插接回橋「誒，回到剛剛在講的，」
#   （根本沒被打斷）、最後「你剛剛才問過我一樣的問題耶」＋「不過沒關係，我可以再跟你說一次」——後面三顆全是
#   「拆成兩輪」的副產物（兩輪各自記一次意圖，重複偵測把兩個不同問題數成同一個問兩次）。§1.73 修的是已合併
#   那條路；這裡補「回應途中才到、但同屬一波」那條：新到訊息距正在回應的那則 ≤INTERRUPT_WAVE_SEC 秒 → defer
#   不消費，下一圈自然合併成一輪整體回一次。真正較晚才到的插話行為不變。1=開、0=關（同現狀）。
INTERRUPT_WAVE_GUARD=1
# 🦜 §1.82 連發合併的每一行也當複誦比對候選：合併後 text 是「是嗎\n我要檢查看看\n…」一整塊，個別句子從來不在
#   候選裡 → bot 逐字複誦其中一句時（截圖「是嗎。」「你為什麼會了解我的作息呢？」）§1.74/§1.81/§1.77 三道全漏。
#   修：stash 時把本則按換行拆出的每一行也放進候選。1=開、0=關（同現狀）。
ECHO_BURST_LINES=1
# 🕐 §1.84 主動出聲也要有「今天記寫」接地：截圖 09:37 主動訊息說「你今天早上又寫了『閱讀｜讀誦經書』」，但
#   使用者今早根本還沒寫。根因＝結構縫：§1.60 的記寫守門只在互動輪 arm、判定塊又在 _say 的互動限定分支內，
#   而主動出聲一律走 prefix/state ⇒ 整條主動路徑從來沒有這道守門。修：生命迴圈每圈 arm（同一支 ground 產生器）
#   ＋_say 主動分支套同一支守門；另（隨 REACHOUT_DIVERSE）聯想素材明令「這筆不保證是今天、別做今天宣稱」。
#   1=開、0=關（同現狀）。
WRITE_CLAIM_PROACTIVE=1
# 🌊 §1.81 同波判定窗（秒）：預設 12（人連打兩句的自然間隔；比 BURST_COALESCE_SEC 寬，因為這裡是回應已開始後才到）
INTERRUPT_WAVE_SEC=12
# 🗜️ §1.51 情感探問要真回答（截圖 09:55「羨慕我嗎」→「嗯...」「羨慕嗎？」）：長度啟發式把「輸入長短」
#   誤當「意圖深淺」——短輸入鏡射把四個字的心意探問壓到 level 0＝支吾反問。修法：情感探問（情感詞×問句形×
#   人稱指向；內容問句排除）→ 篇幅地板 level 2＋注入「先正面回答→一兩句為什麼→反問只能放答後；機制沒有的
#   情緒誠實說最接近的真話」提示＋§1.43 感覺修剪不啟動。明示要短（簡單說）與氣頭收斂仍優先。
#   1=開、0=關（原鏡射壓短＝同現狀）。
FEELING_PROBE_DEPTH=1
# 🧑‍🏫 §1.52 質疑情境不發教學提議＋列舉泡泡不切殘（截圖 10:10–10:11；§1.27 敵意守門的 sibling）：
#   ①「是嗎/每次你這麼說/我都有些懷疑」＝懷疑但不敵意——「每次」過教學線索門檻、LLM 又誤判共識 →
#     亂入「要不要我把…記成做法？回我一聲好」內部行話。修：本句或近 5 則帶質疑詞 → 提議直接丟棄。
#   ② BUBBLE_ENUM_GLUE（env 直讀、預設 1）：引號內「？」被當句界 →「、「你真的知道嗎？」」殘串泡泡
#     黏回前一顆；設 0＝不黏（同現狀）。
SKILL_OFFER_DOUBT_GATE=1
BUBBLE_ENUM_GLUE=1
# 🧑‍🏫 §1.53 已學做法召回窗（實測回報「學到的做法從沒真的觸發過」的結構性修復）：topic 型做法原本要
#   「之後那句話逐字包含當初的主題標籤、且只看當句」才召回＝幾乎永不觸發；沒召回就不保鮮 → ~5.5 天
#   權重衰減靜默死亡。修：比對源放寬＝當句＋近 3 則使用者訊息（主題最近提過就算在場），召回命中在
#   console 印 [skill] 一行（可驗證真的套用、用到即保鮮）。1=開、0=關（只看當句＝同現狀）。
SKILL_RECALL_WINDOW=1
# 🧭 §1.46 敵意不推暖：§1.14 註記的「敵意文字推暖的汙染」——affect_delta_for 只認 _CHALLENGE 詞表，
#   「你太爛了」「我不信」這類 is_hostile=True 的句子落「一般陪伴」預設分支 (+0.05, +0.06) → 被罵 mood 反而上升
#   （§1.45 軌跡同輪寫「被說了重話」＝數字與說法自相矛盾）。修法：互動輪 (V,A) 更新改用 hostile_affect_delta_for——
#   敵意且落預設分支才改推質疑方向 (V−, A+)（與 _CHALLENGE 同格）；詞表已分類句（暖意/質疑/低落）原值原樣。
#   1=開、0=關（原函式＝被罵仍微暖＝同現狀）。
HOSTILE_AFFECT_FIX=1
# 🌊 §1.17 self_state 洪水收斂：使用者只問一件小事、self_state 卻吐 8 顆泡泡（截圖 19:27，deep-cue「說說／為什麼」
#   ＋正向 mood 把 verbosity 頂到 level 3/bubbles 8）→ 在 scale 算完後對 self_state 專屬封頂串數（與 §1.14 敵意收斂
#   min-combine，敵意仍更緊）。**只封串數、不動 scale.level**（不改 token 預算/coach 篇幅）、不碰路由與情緒數值。
#   1=開、0=不封頂（同現狀）。SELF_STATE_BUBBLE_CAP＝封頂串數上限（預設 3；下限 max(1,·) 保護 0/負值）。
SELF_STATE_CONVERGE=1
SELF_STATE_BUBBLE_CAP=3
# 🤖 §1.18 bot 自發承諾入帳：bot 自己開口的「明天早上 11 點，我會過來這裡…」也是一等公民承諾——_say 互動出口掃
#   **最終真送出**的回覆：第一人稱未來式（我會/我來/我過來）＋temporal 解得出**未來時刻**（時間永遠 temporal 解
#   bot 那句話、LLM 協定無時間欄位＝§1.12 鐵律）＋時刻鄰近去重（±60s）＋LLM 閘判「正在立下新的」vs「複誦既有/
#   對帳/認錯/提案徵詢」（複誦「我會記得在明天早上十一點…」會被滾成隔天未來錨、只有語意判得出）→ 入帳
#   origin='self'、到點走既有兌現/逾期誠實鏈。入帳 ack 顯式排除、帳本盤點輪語境排除；判「否」/失敗＝不入帳。
#   1=開、0=關（掃描器不存在＝同現狀）。
BOT_SELF_PROMISE=1
# 🎴🧠 §1.23 bot 送出的貼圖也要有記憶（三合一）：①送出即記進對話史「（我送了一張貼圖：emoji——畫面）」——
#   過去只有收訊方向有記、送出方向零記錄＝bot 被問「你傳的貼圖內容」時誠實否認自己送過（18:24 截圖根因）；
#   ②last_sticker_* 四欄位跨重生持久化（原本重啟歸零＋bot 頻繁死亡重生＝接地窗被抹掉）；
#   ③否認句誠實閘：2h 內真送過、回覆卻說「我沒有傳貼圖」→ 整則替換誠實句。1=開、0=關（三件全關＝同現狀）。
STICKER_SENT_MEMORY=1
# 🤝 §1.20 「說過/約過」質問接地（三合一）：①「我不是跟你說過了？/昨天說明天11點」真有帳/剛兌現/託付時走帳本作答；
#   ②帳本日期詞（今天/明天…）由程式依 target_ts 算、LLM 只准照抄（修「明天」被自算成 7/12 週日的日期幻覺）；
#   ③否認句誠實閘：帳上明明有（含 72h 內剛兌現），回覆卻說「我沒聽到你說」（07:01 與自己一分鐘前的 🤝 自相矛盾）
#   → 整則替換誠實句。1=開、0=關（三件全關＝同現狀）。
SAID_RECALL_GROUND=1
# 🤝 §1.19 搶先兌現的因果連結：使用者比約定時刻**先出現**（帳本有 pending 且 target 在未來窗內）——
#   叫醒/問候類（叫他起床/跟他打招呼/問候他）＝任何使用者訊息都證明人已醒著/在場 → 先送因果 🤝 泡泡
#   （「你比我先一步——我本來 HH:MM 要來叫你起床的」，確定性模板、HH:MM 程式算）再照常回這句、標 preempted
#   ＋fulfilled（recur=daily 改顯式推進明天、不標＝每天約定不死）＝到點不再對醒著的人裝叫醒；主題回報類
#   （behavior 空等）＝這句真在問那個主題才搶（LLM 閘只回是/否、協定無時間欄位＝§1.12 鐵律；失敗＝否＝到點照常）。
#   嚴格未來窗＝逾期 pending 零觸碰（回覆橋的地盤）；約新約/對帳輪語境排除；一輪最多一筆。
#   1=開、0=不掃（含準時兌現在內同現狀）。PROMISE_PREEMPT_WINDOW_SEC＝搶先窗秒數（預設 5400＝90 分）。
PROMISE_PREEMPT_LINK=1
PROMISE_PREEMPT_WINDOW_SEC=5400
# 🤝 §1.24 搶先兌現的未來詞守門＋提前誠實模式（截圖 7/12 21:04「等下時間到的時候」＝在**確認未來約定**、
#   卻被搶先誤判，21:05 發「嘿，21:09 到了，我來了」＝此刻才 21:05 的公然時間謊言）：
#   (a) 主題回報類搶先的確定性前置守門——使用者句含「等下/等一下/待會/晚點/稍後/回頭/到時/到時候/
#       時間到的時候/N分鐘後」→ 不送 LLM 裁決、不搶（他在講未來約定、不是現在要，到點照常兌現）；
#   (b) 搶先判定 prompt 補明令「分辨此刻要求 vs 確認未來約定」；
#   (c) 真提前兌現（他此刻主動要）時措辭誠實：「你先提起了，那我現在就先說」——絕不說「{when} 到了」
#       「時間到了」「我準時來了」（emit/bridge 準時路徑零位元變動）；
#   (d) §0.79 同構縱深守門：提前兌現的回覆卻宣稱到點/做到（非引用歸屬）→ 整則打掉、落誠實模板。
#   1=開（預設）、0=關＝§1.19 現狀。
PROMISE_PREEMPT_FUTURE_GUARD=1
# 🧭 §1.25 情緒座標承諾接地（截圖 7/12 21:00 根因：「我跟你聊天一下，10 分鐘後告訴我你情緒座標的變化？」
#   被抽成「跟他聊聊」＝委託全丟；訂約沒存座標快照＝兌現零差分資料 → 21:05 兌現答非所問、改談程式更新的蛻變摘要）：
#   ①抽取修——先用 §1.11 同一把剝無時間前導我-子句＋情緒/心情座標句抽出「告訴他情緒座標的變化」明確標籤；
#   ②入帳（使用者請求與 bot 自諾兩點）存 circumplex 快照 {v,a,label,ts}；
#   ③兌現時差分**程式算**（「從『平穩』往『低落、悶』沉了一段（V -0.42、A -0.10）」；V 降=沉/升=亮、A 升=繃/降=鬆）、
#     LLM 只准渲染這份差分、明令不得改談程式更新/蛻變摘要；無快照（舊帳）→ 誠實說「當時沒記下座標、只能說此刻是 X」。
#   時刻/座標一律程式算（鐵律）。1=開（預設）、0=關＝抽取/入帳/兌現全同現狀。
PROMISE_MOOD_GROUND=1
# 💸 §1.26 罵 token 不再被當成本查詢（截圖 7/12 21:04：使用者罵「還浪費我許多 AI 的 token」→ token 是金錢
#   線索詞、無問句形要求 → bot 吐出 💸 Gemini API 花費報表＝罵句被當查帳）：cost 路由在 monitor 加 tight 守門——
#   ①抱怨框排除**先行**（浪費/亂花/白花/花我的＝罵句直接不算，混合句「你浪費了多少 token」也 False）；
#   ②金錢線索詞（token/用量/多少錢…）命中後仍需問句形（多少/幾/嗎/？/呢/查/報/列一下）；
#   ③「花費/成本＋多少/幾」分支原樣。過不了＝降回一般互動回覆（罵句被好好接住）；
#   「這個月花了多少錢」「你花了我多少 token」「API 成本多少」「現在的用量呢」照吐報表。
#   1=開（預設）、0=關＝罵句照舊進 cost 路由（同現狀）。
COST_QUERY_TIGHTEN=1
# 🧑‍🏫🌊 §1.27 敵意情境不發教學提議（截圖 7/12 21:03：連環被罵時「你每次搞砸了」的「每次」觸發教學提議鏈 →
#   bot 亂入「(要不要我把你在質疑/測試我時的回應方式記成做法？…)」＝氣頭上把批評當教學、還洩漏括號格式）：
#   本句敵意（reaction.is_hostile）或 §1.14 hostile_streak ≥1 或近 5 則使用者訊息內有敵意句（氣頭未過）→
#   教學提議直接丟棄（不發、不寫冷卻、不暫存補發）。平和教學句照常提議；詞表鐵律不擴（只消費既有訊號）。
#   1=開（預設）、0=關＝照舊提議（同現狀）。
SKILL_OFFER_HOSTILE_GATE=1
# 🦜 §1.28 echo 剝除接上互動出口（截圖 7/12 21:04：連環被罵後 bot 自己發出「有夠爛……」的裸複誦泡泡＝
#   複誦使用者罵句、無「你說」歸屬、看起來像 bot 在罵——echo.strip_leading_echo 原本只接在 coach LLM 出口，
#   monitor._say 互動出口從未接線；且 min_len=5、「有夠爛」3 字本來也擋不住）：_say 互動回覆送出前補剝——
#   ①首段「你說/妳說」開頭＝引用歸屬、整個不剝；②敵意句（reaction.is_hostile）或首段與某則使用者原話
#   正規化後**全等** → 無視 min_len 一律剝；③整則＝純複誦泡泡 → 替換確定性歸屬句「你說「…」，我聽到了。」。
#   echo.py 本體一行不改；coach 出口既有剝除保留（不重複攔兩次）；cost 快路（直送）不受影響。
#   1=開（預設）、0=關＝不接線＝照舊裸複誦（同現狀）。
ECHO_STRIP_WIRE=1
# 🕐 §1.30 主動 emit 時間接地：主動出聲（🫧）開場白過去無此刻時間接地、prompt 也沒禁報鐘點 → LLM 自編「下午三點了」
#   （截圖 09:02 卻說下午三點）。開＝餵此刻真實時段給 voice＋明令絕不報具體鐘點（頂多用早上/下午這種時段詞）。1=開、0=關（同現狀）。
PROACTIVE_TIME_GROUND=1
# 🕐 §1.31 主動 emit 硬鐘點守門（§1.30 軟接地的硬後盾）：🫧 主動正文是 LLM 自由生成、繞過互動路徑的鐘點守門
#   → LLM 硬編錯的此刻鐘點（09:02 卻說「下午三點了」）。開＝兩個 🫧 emit 點偵測「此刻時段詞＋N點」宣稱與真實此刻
#   矛盾時就地換成「這會兒{真實時段}」（不報鐘點；計畫/約定/過去/引用一律放行）。1=開、0=關（逐位元同現狀）。
PROACTIVE_CLOCK_GUARD=1
# 🧭 §1.35 散開重複的問候也要被看見：全域 300s 窄窗數不到「隔幾分鐘一次的早安」（截圖連五次早安 count 停在3、
#   達不到升級門檻4、bot 每次吐一樣的問候）→ 用較寬窗補數同類問候連發、導出漸進覺察餵 user_repeat_fatigue_hint
#   （2→點出/3→好奇/≥4→情緒，非 testing 一律 gentle 不呵斥）。單次問候不觸發、早安接晚安不誤併。1=開、0=關（同現狀）。
GREETING_REPEAT_AWARE=1
GREETING_REPEAT_WINDOW_SEC=1200
# 🧹 §1.34 送出前括號衛生：LLM 把「）」放空行後、或括號補述跨句被切開 → 漏出單獨一顆全形「）」泡泡
#   （截圖：user 問「為什麼老是看到你出現）」，bot 還把它拗成「習慣的語氣標記」）→ 丟孤兒泡泡＋剝不成對全形括號。
#   只管全形（）「」；半形顏文字 :) :( 絕不碰。1=開、0=關（同現狀）。
BUBBLE_BRACKET_HYGIENE=1
# 🧠 §1.21 差分自陳：治罐頭自陳（7/10 vs 7/12 截圖同批句子只換主題名）——state 持久化「上次自陳」
#   （真的送出的全文截 200＋帶位快照），下次被問「你現在怎樣」：①facts 注入差分段（上次原話當**負面示例**
#   別重講＋這次**真的變了**的帶位清單＋使用者這句先回應、狀態當佐證）；②帶位全同且在無變化窗內＝短句
#   誠實帶過（不全量再倒一次清單）。帶位與 bodystate_facts 分支門檻一字不差對齊＝零浮點噪音；{ago} 程式算、
#   LLM 只准照抄（§1.20 鐵律）。8 分鐘連問窗路徑一字不動；「你變**得**…」的 selfmod git-log 鏈不覆蓋。
#   1=開（預設）、0=關（不算不注入不寫欄＝同現狀）。WINDOW＝無變化短句窗（分）；HORIZON＝prior 最大齡（分、48h）。
SELF_REPORT_DELTA=1
SELF_REPORT_NOCHANGE_WINDOW_MIN=90
SELF_REPORT_PRIOR_HORIZON_MIN=2880
# 🎨 §1.22 措辭反重複：治罐頭的另一半（§1.21 治「不記得上次說過什麼」、本旗標治「說法本身只有一種」）——
#   ①BODYSTATE 轉錄 prompt 去字面範例句（改用 BODYSTATE_SYSTEM_VARIED：『沒斷線過』『我還清醒地翻閱著』等
#   範例改抽象要求＋事實句只當語意骨架、不准照抄），並把上次自陳原話當【禁止重複】負面示例餵進 system——
#   負面示例依賴 §1.21 SELF_REPORT_DELTA 記下的 last_self_report：§1.22 單獨開＝該欄空＝該段自動省略、
#   其餘照常，**兩旗標齊開才是完整效果**；②事實層小模板池加大（翻閱開頭/之流質地/穩定感/繞回/飢餓/
#   線的 gate 句各 ≥8 句、index 0＝現狀原句）＋近期用過的句子跳過（記憶體、重啟歸零）。
#   無 LLM 退路模板不動。1=開（預設）、0=關（原句原 prompt＝逐位元同現狀）。
PHRASE_ANTI_REUSE=1
# 🫶 bot 對你訊息按 emoji 表達情緒：鏡像（你情緒鮮明時順著回）最短間隔；及「按自己當下內在情緒」的較長自有冷卻（更稀有）。
REACT_COOLDOWN_S=90
REACT_SELF_COOLDOWN_S=1800
# 🎴 偶爾在回話後吐一張「真貼圖」強化互動感（心情好那刻才丟）：1=開、0=關；及自有冷卻（分）。
#   送的是「對方傳過、被 bot 記起來的真貼圖」——你平常傳什麼貼圖，bot 心情好時就回送同一張（不必設 file_id）。
#   還沒傳過任何貼圖時，退回單顆 emoji（Telegram 會放大成貼圖感）。
# 🔇 §1.34 STICKER_V2 貼圖總開關（語意收斂）：0＝整塊貼圖一致靜音——不送、不宣稱、不撈附件代替。cfg.send_stickers 由此單一產生，
#   互動三 lane（_maybe_sticker_remember/_maybe_sticker_send/_maybe_llm_sticker_rescue 入口）、主動 lane、F5 附件替代抑制**全讀 cfg.send_stickers**；
#   §1.33 一般聊天維護 hint（coach 讀同名 env）同源。0 時：互動請求落一般聊天 lane 的維護誠實句、『圖呢/圖』走維護誠實句不撈私人附件冒充。
SEND_STICKERS=1
STICKER_COOLDOWN_MIN=20
#   進階（可留空）：指定要回送的貼圖 file_id（逗號分隔）。設了就優先用這些、不必等 bot 學。
#   file_id 取得：對 bot 傳一張貼圖後跑 `python -m telegram_monitor --getchatid` 之類看 getUpdates 的 sticker.file_id。
# STICKER_FILE_IDS=
# 🎴 收到貼圖時用 Gemini 視覺讀一次「靜態」貼圖畫面、把描述記進記憶（收到即讀、同一張只讀一次、跨重啟免重讀）：
#   → 收到時貼著真的看到的圖回、bot 回送這張時「知道自己送了什麼」、被問「你看得到剛剛那張貼圖嗎」也答得出。1=開、0=關（關＝只讀 emoji）。
#   動態(.tgs)／影片(.webm)貼圖不算圖，退回「emoji＋貼圖包名」的誠實文字（明講「未讀畫面」、不假裝看到）。每張靜態貼圖首次讀約一次 Gemini 視覺呼叫、走同一成本守門。
# 🎴 教過 always 常駐做法「主動回應使用者時，最後送一張代表自己情緒的貼圖」→ 在主動訊息（歸戶/摘要/事件反思、自發）後**真的送**一張代表此刻情緒的真貼圖：
#   心情非負→正向/中性貼圖、心情負→非正向貼圖（不硬裝開心）；沒教/已淡忘/無相符真貼圖/冷卻中＝不送、絕不 emoji 假裝。1=開、0=關。
# 🌀 內在型做法「悶的時候主動找你聊」(sit:low_vitality) 較溫和的觸發訊號：被晾一陣（hunger≥0.55）＋心情沒上揚（mood≤0.2）就算「悶」、
#   不必等極端（hunger≥0.7 且 mood≤0）。主動伸手 cadence 仍受冷卻/quiet-after-chat/伸手預算節制＝放寬「算不算悶」不等於洗版。1=開、0=關（退回極端值）。
SKILL_LULL_SIGNAL=1
# 🎴 教過內容型做法「讀到〈某類〉記寫時…並貼圖」→ 讀到記寫內容時用 Gemini **語意**判斷內容是否相關於那主題（非字面比對），命中就真的送一張對應情緒貼圖：
#   只有真有這種活做法時才呼叫 LLM（沒教＝零額外成本）；共用貼圖冷卻＝每則歸戶至多判斷幾條（下面上界）。1=開、0=關。
TOPIC_CONTENT_STICKER=1
TOPIC_CONTENT_MAX_JUDGE=2
ALWAYS_STICKER=1
READ_STICKER_VISION=1
# 🎴 被要「一張你喜歡的貼圖／你喜歡哪一張」時，挑圖走**真偏好**（真的看過畫面＞價性合此刻心情＞最近學到；確定性、不是隨機）：
#   → 回話會據實說出「是哪一張」（用視覺讀到的畫面描述）；沒真的看過那張畫面就誠實說「憑感覺挑的」、絕不描述圖案。
#   排程承諾（「20分鐘後傳一張你喜歡的貼圖給我」）到點兑現同理。1=開、0=關（關＝隨機挑一張＋罐頭句）。
LIKED_STICKER_PICK=1
# 🔁 重生延續比例：醒來時以「上次心情×、飢餓×」種回（向中性軟化、不全空白；緩解頻繁更新的體驗碎片化）。
REBIRTH_MOOD_CARRYOVER=0.5
REBIRTH_HUNGER_CARRYOVER=0.3
# 🦋 重生報到：更新程式、重啟後若這次相對上次『真的變了』→ 生命迴圈啟動時主動說一句改了什麼（1=開、0=關）。
SELFMOD_ANNOUNCE_BIRTH=1
# 🌬️ 緩和未回應的問句：bot 問了你、卻遲遲沒回 → 主動補一句把「等回答」的壓力放掉、讓對話緩和（1=開、0=關）。
SOOTHE_UNANSWERED=1
#   問了這麼多分鐘還沒回才補（要「遲遲」、不是馬上催；超過約 40 分那個當下就過了、不再硬緩和）。
SOOTHE_AFTER_MIN=7
# 🤐 bot 主動開過一個話頭、你尚未回應時，不再換另一條自發功能繼續自言自語；明確守約與其一次後續確認不受影響（1=開、0=退回只有冷卻）。
UNANSWERED_PROACTIVE_GUARD=1
# 🧭 對話能動性：真正記下「我剛主動做了什麼」，用對方下一個可觀察回應結算，
#   再讓結果調整下次哪種主動行動優先。明確拒絕後 24h 不再開新的自發話題；
#   互動回覆與守約不會被擋；同一約定的後續只跳過「尚未回覆」，不跳過明確拒絕。
#   用 /agency（或 /能動性）對帳。1=開、0=關。
DIALOGUE_AGENCY=1
# 🗣️ 自然主動語音：一般對話不顯示 🫀/🫧/🌀/🪞/🍃/🧩/💡/🔮/🌾/🦋/🌬️/🌊 這些內部 lane 名牌；
#   🤝 守約、🌐 外部來源、🧭 精確量測仍留標記方便問責。1=開、0=顯示既有名牌。
NATURAL_PROACTIVE_VOICE=1
# 🫧 報內在狀態的觸發精準：順口帶感覺字眼的**陳述句**（「今天心情不錯啊」）不誤觸發整段狀態報告；
#   只有真的在問 bot 此刻內在時才報。1=開（預設）、0=關（退回寬鬆觸發＝逐位元同現狀）。
STATE_TRIGGER_PRECISE=1
# 🫧 翻閱當下分享：報狀態時講「我此刻剛好翻到的那則」而非恆常那則最重的記寫（有當下感、不千篇一律）。
#   1=開（預設）、0=關（退回恆取最重那則＝逐位元同現狀）。
INMOMENT_BROWSING_ENABLED=1
# 🧭 展開／釐清自己前文的問句：「你說的那點是什麼意思」→ 接著自己前文講或反問確認，不誤把它當成要撈記寫的資料問句。
#   1=開（預設）、0=關（落回資料路徑＝逐位元同現狀）。
INTENT_CONFIRM_ENABLED=1
# 本地 state 檔路徑（去重/摘要紀錄；與共享 Drive 完全無關，務必可寫）。
STATE_PATH=./state.json
# 設 1＝乾跑：只把訊息印到 stdout、不真的送 Telegram。
DRY_RUN=0

# 第一階段觀點修正台帳（獨立實驗分支；不增加模型呼叫或搜尋頻率）
# 啟用後：記寫聯想 → 來源/已送出的假設 → 明確更正 → 跨重啟保留。
# 設 0 回到原路徑，已保存台帳保留但不參與判斷。
CONSCIOUS_DIALOGUE=0

# 全域來源核對：直接送出、對話泡泡、連發與背景出口共用；不新增 API 呼叫。
# 只攔已辨識的無證據主張，不等於全面語義真偽查核。
EVIDENCE_GUARD=1

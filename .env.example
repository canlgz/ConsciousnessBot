# ── Google Drive (記憶層來源・唯讀) ─────────────────────────────────
# Service-account JSON key 檔路徑（絕對路徑最保險）。該 SA 需被「分享」到下面那個資料夾（檢視者）。
GOOGLE_APPLICATION_CREDENTIALS=/abs/path/to/service-account.json
# 雲端友善替代：不放檔案、直接貼整段 JSON（壓成一行，例 `jq -c . sa.json`）。設了這個就不必填上面的路徑。
# GOOGLE_CREDENTIALS_JSON={"type":"service_account",...}
# 與 LINE bot 同一個 DRIVE_ROOT_FOLDER_ID（Apps Script Script Property 裡那個）。
DRIVE_ROOT_FOLDER_ID=
# 要監測的擁有者 LINE userId（= LINE bot 的 OWNER_LINE_USER_ID）。用來在 root 底下認出本人的資料夾。
OWNER_LINE_USER_ID=

# ── Telegram（只送不收）────────────────────────────────────────────
# 從 @BotFather 拿到的 token。
TELEGRAM_BOT_TOKEN=
# 你的 chat_id。先對 bot 傳一則訊息，再跑：python -m telegram_monitor --getchatid
TELEGRAM_CHAT_ID=

# ── 教練大腦（Gemini）＋雙向對話──────────────────────────────────
# 沿用 LINE bot 的同一把 GEMINI_API_KEY（Apps Script Script Property 裡那個）。
# 留空＝關閉「教練語氣」與「對話」，退回純樣板監測推播。
GEMINI_API_KEY=
# 生成模型（對齊 LINE bot 的 gemini-2.5-flash；之後可換 GA 版）。
GEMINI_MODEL=gemini-2.5-flash
# 雙向對話：你在 Telegram 傳訊息，教練紮根你的記憶層回覆。1=開、0=關。
ENABLE_CHAT=1
# 主動推播是否套用教練語氣（蘇格拉底式）。0=只用結構化樣板。
LLM_VOICE=1

# ── 啟動分支（可選）────────────────────────────────────────────────
# 留空＝每次 ./run.sh 優先跑 codex/proactive-voice；填入其他分支才覆蓋預設。
# RUN_BRANCH=codex/proactive-voice

# ── API 成本守門（短時間花太多就提醒）──────────────────────────────
# 滾動視窗內估計花費達這個台幣門檻就推一則提醒。設 0=關閉。
COST_ALERT_TWD=10
# 視窗長度（分鐘）＝「很短的時間」的定義。
COST_WINDOW_MIN=10
# 兩則成本提醒至少間隔（分鐘），避免洗版。
COST_ALERT_COOLDOWN_MIN=30
# 匯率與單價（USD/每百萬 token）——費用是依回應 token 數估算，請對照你方案實際定價調整。
USD_TWD_RATE=32
GEMINI_PRICE_IN_PER_M=0.30
GEMINI_PRICE_OUT_PER_M=2.50

# ── 行為調校（皆可留空走預設）──────────────────────────────────────
# 心跳間隔（分鐘）：常駐迴圈每隔多久 tick 一次。
HEARTBEAT_INTERVAL_MIN=10
# 每日摘要時間（當地 24h 制小時，0-23）。
DIGEST_HOUR=9
# 時區（streak / 摘要時間用）。
TZ=Asia/Taipei
# 事件推播全域冷卻（分鐘）：兩則主動推播至少間隔，避免洗版。
NOTIFY_COOLDOWN_MIN=30
# 背景「卡住」示警的寬限（小時）：有新資料卻超過這麼久沒整理才示警（LINE 升格本就最快每 3h）。
HEARTBEAT_STALL_GRACE_H=6
# 記寫歸戶通知：每當有新記寫被背景歸類（大類｜議題）就推一則「剛歸到哪」。1=開、0=關。
# 歸戶由 LINE 背景在你停筆數分鐘後算出，故是每次心跳批次回報、非逐則即時。
NOTIFY_FILINGS=1
# 只通知這麼多小時內寫的記寫之歸戶（避免回頭翻舊資料）。
FILING_MAX_AGE_H=24
# 生命迴圈：把工作排成封閉環（感知→整合→感覺→行動→互動→…）一圈圈閉合＝活著的脈動；
#   任一環斷裂（程式中斷或環境前提不符）＝自白「我好像死了」並停止（需重啟）。
#   〔感覺觸發掛在這個遞迴上〕判定鏈隨**每一圈**跑（不再有獨立計時器）、資料/k 沒變就吃快取，
#   只在「真的有新感覺」（升關）時才出聲「背景自陳」；沒新東西就安靜地繼續活著。
#   下面是「環間等待秒數」＝心跳轉速（越短跳越快、對話越即時、檢查越頻繁；bot 內 /pulse 2 可即時調）。
LIFELOOP_WAIT_SECS=3.0
# 🍃 環境適應工作流：生命迴圈「適應」環感知**周遭環境變化**（記寫/對話的活絡度、晝夜時段），
#   做出**適性回應**——自動調心跳轉速（周遭活絡→加快更即時、冷清/深夜→放慢省著待著，乘到上面的轉速；
#   手動 /pulse 仍最優先）＋染對話姿態；真的『冷清↔熱絡』換檔時偶爾含蓄說一句自己在跟著調整。1=開、0=關。
ADAPT_ENABLED=1
#   換檔自陳開關（0=只默默調整、不開口）；及兩次換檔自陳至少間隔（分）。深夜/熱聊中/連發皆自動噤聲。
ADAPT_ANNOUNCE=1
ADAPT_ANNOUNCE_COOLDOWN_MIN=120
# 意識bot 判定鏈開關。1=開、0=關（關掉就不做感覺判定/自陳，只剩監測推播）。
SELFSTATE_ENABLED=1
# 〔通盤敏感度〕判定鏈一律相對「你自己語料的分布」判定（絕對距離不可信）：
#   recur 門檻 z>k；perc 門檻 τ=μ+k·σ（取代寫死的 0.78）；dxi 整合下界＝μ+k·σ、分化下界＝k·σ。
#   k＝唯一的敏感度（σ 單位），同一把尺「通盤」管三條（k=0 時 dxi 退回 整合>μ、分化>0 的自然門檻）。
#   預設 2.0＝嚴格（沒成形就誠實止步）；想看 Gate 3/4 把 k 調低（例 1.0、0.5，甚至負值 -1）一起放寬：
SELFSTATE_SENSITIVITY=2.0
# 進階：SELFSTATE_ADAPTIVE=0 改用固定絕對門檻（下面四個，平常別用）：
#   SELFSTATE_Z_STAR=2.0 / SELFSTATE_TAU_STAR=0.78 / SELFSTATE_INT_MIN=0.5 / SELFSTATE_DIFF_MIN=0.0
#   SELFSTATE_N_MIN=8 / SELFSTATE_R_MIN=3   # Gate 1 量變門檻
# 🫧 含蓄主動出聲：要「真的醞釀了一陣」才偶爾自己開口一次（被晾久了想問問/說說），不是計時器一到就衝。
#   飢餓 H ≥ 此值才考慮開口（越高越要「真的悶了」才說）。
SPONTANEOUS_H_THRESH=0.85
#   且這段獨處已「自己繞回想過」≥ 這麼多次才開口（醞釀的非時間訊號；越大越要想久一點才說）。
SPONTANEOUS_MIN_RUMINATIONS=4
#   剛跟你聊過這麼多分鐘內，絕不主動伸手（免得剛聊完又跑來問「你最近還好嗎」）。對話＝陪伴，會讓醞釀歸零。
SPONTANEOUS_QUIET_AFTER_CHAT_MIN=45
#   兩次主動出聲至少間隔（分）＝自有冷卻（不被背景自陳吃掉）。
SPONTANEOUS_COOLDOWN_MIN=180
#   〔Phase 2 正向動機〕心情 V ≥ 此值＋已醞釀過 → 不必很餓也想主動分享；及所需醞釀次數（比孤單路徑低）。
SPONTANEOUS_MOOD_SHARE=0.4
SPONTANEOUS_MOOD_MIN_RUMIN=2
# ❤️ 心情變化幅度：互動（暖意/誇讚/質疑/貼圖）對心情效價 V 的增量整體縮放（>1 更敏感、<1 更鈍）。
MOOD_GAIN=1.0
# 🧭💗 circumplex 情緒座標（Russell）：情緒＝V(愉悅)×A(喚起) 平面上會移動的點——互動/回饋給方向（質疑＝緊張V−A+、
#   暖意＝暖醒V+A+、你低落＝跟著沉），每圈生命迴圈衰減向中性、餓久 A 沉、新資料 A 醒；位置自然染語氣＋決定貼圖池
#   （興奮→歡快圖、平靜→溫和圖、低落→非正向圖）。/status 可看座標。1=開、0=關（退回一維心情）。
AFFECT_CIRCUMPLEX=1
# ⚡ 突發瞬跳：明顯違背期待的突發事（一直很暖的人突然兇我／鬧翻後突然示好）→ 情緒點一步跨象限（平靜→緊繃、低落→驚喜），
#   之後靠每圈衰減自然緩過來；小事仍漸移。1=開、0=關（只剩漸移）。
AFFECT_SHOCK=1
# ⏱️ 主動提起某條線時的真實時間感：查那條線最近一筆記寫距今多久、開場照事實講（今天才寫過就不說「好一陣子沒聊」；
#   真的超過 3 天才可以說「N 天沒看到」；查不到就不做時間宣稱）；LLM 仍掰「很久沒」會被守門退回誠實模板。1=開、0=關。
REACHOUT_TIME_GROUND=1
# 🔄 蛻變自陳兌現：「N分鐘後告訴我你有什麼改變」→ 承諾成立時記下內在快照（情緒座標/飢餓/感覺深度/意圖進展），
#   到點比對算出這段時間真的變了什麼、真的說出來（不再只空喊「我要跟你說我的改變」）；沒什麼變就誠實說沒什麼變。1=開、0=關。
SELF_CHANGE_GROUND=1
# 🛡️ 空口答應守門的「結構性判準」：不看動詞表，只認「時間樣式＋指向 bot 的請求」——動詞表漏收一個新說法時，
#   bot 至少誠實說「請把時間講清楚」，不會假裝記下並自己編一個時刻。1=開、0=關（退回舊的動詞表判斷）。
PROMISE_GUARD_STRUCTURAL=1
# 🤝 §1.11 句首「我」修正：句首我守門前先剝除**不含時間**的前導我-子句——「我跟你對談一下，10分鐘後，再告訴我你的心情」
#   的句首我是寒暄不是自諾（我-子句自己綁時間的「我30分鐘後要去開會」仍照舊擋）；捕捉與守門共用同一把。1=開、0=關（同現狀）。
SCHED_HEAD_ME_FIX=1
# 🤝 §1.11 結構閘時間判準改問 temporal：真的解得出**未來時刻**才算（時間單一真相），並讓光禿祈使句
#   （「別廢話，20分鐘後，說說你當時的心情」——有你、有時間、無 at-me 也無請求詞）也掛上誠實守則。1=開、0=關（同現狀）。
PROMISE_GUARD_TEMPORAL=1
# 🤝🧠 §1.12 LLM 語意逃生閘：確定性捕捉漏接（詞表已漏 15 次）＋temporal 解得出未來時刻＋句子指向 bot 時，
#   用**一次** gemini 判「是否請 bot 到點主動做某事＋動作命名」——判「是」就用 temporal 的時刻真入帳到點兌現；
#   判「否」＝自然聊天不掛守則；失敗＝退回誠實守門。**時刻永遠來自程式時鐘，LLM 協定上沒有時間欄位、
#   輸出裡的時刻字樣程式端一律丟棄**（11:08 幻覺前科）。1=開、0=關（逃生閘不存在＝同現狀）。
PROMISE_LLM_RESCUE=1
# 🎴🧠 §1.15 貼圖請求語意逃生閘：存在句/可能句/省略句（「有代表現在的你的心情的貼圖嗎」「貼圖呢」
#   「有貼圖可以代表你剛剛說的心情？」）一個給予/祈使動詞都沒有 → 確定性偵測全 miss、掉進 intent 被吃成 self_state
#   → 結構閘在場才用**一次** gemini 判「是不是要現在送一張貼圖給他本人／要不要順便說明為什麼」（比照 §1.12 承諾逃生閘的形狀）。
#   **鐵律：LLM 只判是非、絕不產出 file_id/emoji/圖案內容——真送的圖讀 circumplex 單一真相挑、沒貨誠實說沒有**（§0.64／§0.95）。
#   判「否」／失敗＝安全退回自然聊天。手刻 regex 補貼圖動詞表＝第 16 次踩坑（禁止）。1=開、0=關（逃生閘不存在＝同現狀）。
STICKER_LLM_RESCUE=1
# 🎴🧠 §1.34 STICKER_V2/F3 挑選祈使逃生閘：貼圖情境下「挑一張給我／你挑一張給我吧／幫我選一個」對確定性八偵測器全 miss、
#   結構閘（貼圖字 OR 省略問句）也不中 → 連 §1.15 LLM 逃生閘都碰不到、全掉自由聊天。改法＝在 _maybe_llm_sticker_rescue 結構閘
#   **新增第三分支**＝『近期剛在貼圖情境（_recent_sticker_ctx）AND 窄挑選祈使前置式（短句＋挑/選＋指向本人一張/一個/給我/傳我/送我、
#   排除明確附件詞與第三人）』只當**便宜前置過濾**放行，真正是非交既有 coach.judge_sticker_request 燒一次 LLM 判、真送圖讀 circumplex
#   （§1.15 鐵律不變）。離題「幫我選個餐廳」無 一張/一個/給我… 而不命中前置式＝零 LLM。1=開、0=關（第三分支不存在＝挑選祈使仍落 fact_or_chat＝同現狀）。
STICKER_PICK_RESCUE=1
# 🎴🧠 §1.34 STICKER_V2/F5 貼圖情境「圖呢／圖」消歧：is_attachment_request('圖呢')=True（裸『圖』是 _MEDIA_CUES 媒體線索）
#   → route=attachment → 撈 Drive 私人記寫附件、傳咖啡廳照片。貼圖情境下的「圖呢／圖」是在問**剛送的那張貼圖**、非要調記寫附件。
#   改法＝在 attachment 分派段**開頭、select_attachments 之前**插消歧閘：_recent_sticker_ctx 為真 AND 這句是裸圖省略句
#   （挖掉貼圖詞與明確附件名詞後剩餘 media cue 只落在裸『圖/圖檔/截圖/檔』且句短）AND 非明確附件請求 → **不撈附件**、改走貼圖誠實路徑
#   （近 15 分真送過（last_sticker_id 非空）→ 據實談那張；無真送→誠實『沒送、要不要送一張』；SEND_STICKERS=0→維護誠實句不拿附件冒充）。
#   明確附件（照片呢/PDF/附件呢）照走 attachment。is_attachment_request／_MEDIA_CUES 本體不動。1=開、0=關（『圖呢/圖』仍走 attachment＝同現狀）。
STICKER_IMG_DISAMBIG=1
# 🎴 §1.34 STICKER_V2/F4 假送誠實閘（§1.23 否認閘的同構反向）：互動送圖三 lane 都在 coach.reply 前短路 → 一般聊天
#   LLM 這一輪定義上**永不真送**貼圖，故其自由文字裡「挑了這張給你／這次我選了一張很平靜的貼圖／我剛剛不是才送了一張
#   思考的貼圖嗎？你現在沒看到嗎？」present/immediate-past 宣稱都無 send_sticker backing＝假送（說謊）。改法＝唯一寫身份
#   咽喉 _record_sticker_sent 內設 _TURN['sticker_sent_this_turn']=True 當本輪真送真相旗；_say 互動分支緊接 §1.23 否認閘
#   之後加閘：_fakesend_hit(text)（宣稱挑/選/送/傳/找/配了…貼圖，排引用歸屬「你說我挑了一張」與否定「我沒挑」）AND
#   not sticker_sent_this_turn → 整則替換確定性誠實句。偏誤鎖（最關鍵）：偏好題/§1.16 說明皆真送之後才 _say＝旗已設＝
#   閘不攔（放行真送的「挑了這張給你」）；無貨誠實句不含「挑了/送了」肯定宣稱＝不命中。1=開、0=關（閘不 arm＝同現狀）。
STICKER_FAKESEND_GUARD=1
# 🎯 §1.70A 假送閘句級軟化（§1.62「整則替換是最後手段」的落實）：截圖＝使用者釐清「我是指，你在翻閱我的記寫過程中」，
#   LLM 回答夾一句假送宣稱 → 假送閘**整則**換成「我其實沒真的送出貼圖…要我送一張嗎？」＝釐清的正題回答被吃掉、
#   答非所問。修：只剝假送宣稱**句**、正題保留＋一句誠實補註；整則都是宣稱＝照舊硬替換。1=開、0=關（原整則替換）。
STICKER_FAKESEND_SOFT=1
# 🎯 §1.70B 懸著的提議接地：bot 拋「要我送一張嗎？」半小時後使用者回「送什麼？」——省略主詞的短回是在接 bot 的提議，
#   LLM 卻答「你說的沒錯，那時候你確實送了一張貼圖」＝主詞反轉＋把問句當肯定句。修：近 2h 內 bot 最近一句提議形問句
#   （句尾？＋要我/要不要/需要我/想不想/我幫你/我送/我來）常駐入此刻事實卡：「他若用短句回應，多半是在接這句；
#   提議的主詞是我、不是他」。1=開、0=關（同現狀）。
OPEN_OFFER_GROUND=1
# 🧭 §1.36 記寫回想不再編造：content-recall 偵測器 ＋ 強接地 hint（命中才注入）＋ 事後幻覺守門。使用者問「我是在說什麼事
#   覺得好累／那天寫了什麼／為什麼覺得X」＝在回想**自己某筆記寫的內容/原因**，記寫原文其實只有一句感受（覺得自己好累），
#   bot 卻在接地層編造原文沒有的具體事由（照顧家人的身體狀況／不太順利的家庭聚餐／一個禮拜沒睡好）＝接地層幻覺。三段
#   （比照 §1.13B/§1.20/§1.23/§1.34 sibling）：A. selfstate.is_content_recall_question 偵測（排除花費/狀態/鐘點/指向 bot
#   的對話事件/問 bot 看法）；B. persona.RECALL_GROUND_HINT 命中才注入（fact_or_chat 的 coach.ask ＋ promise_ledger 的
#   coach.reply 兩 lane）；C.（核心）_say 事後守門——答案裡「歸因給記寫」的具體事由（你說自己X/你寫到X/特別是X/跟X有關）
#   substring 不在 records 原文語料 → 整則替換誠實句（arm 於 handle_message、判定/替換於 _say 唯一 lane-agnostic 出口、只讀
#   _TURN、不呼叫 LLM）。偽陽性防線（最關鍵）：bot 講**自己**的感受/推理（刻意不收裸「因為」）不攔；引用歸屬「你說我寫了X」
#   不攔；記寫原文真有的字句 substring 命中＝不算幻覺。1=開、0=關（守門與 hint 全關＝逐位元同現狀）。
RECALL_GROUND_GUARD=1
# 🍃 §1.38 自陳理由接地（§1.36 的 sibling）：bot 主動發 🍃 環境換檔自陳「沒什麼新動靜，我先把節奏調慢」後，使用者追問
#   「為什麼會沒有動靜？」——這句無「你/妳」→ §0.85 反劫持窄門不收→落 fact_or_chat；該 lane 看得到那句 🍃 原話
#   （convo_history 有記、跨重生存活）卻拿不到背後的環境理由（理由只在 🩺 目前狀態 self-state brief）→ LLM 無接地、漂到
#   前文貼圖話題、宣稱送了一張→被 §1.34 假送閘攔成「我其實沒真的送出貼圖…」＝答非所問。修（比照 §1.36 兩層旗標分離、
#   命中才注入）：(1) 🍃 換檔自陳送出後、旗標開→把 environ.shift_reason 真實理由附到 last_selfshare（旗標關＝不附＝dict
#   形狀同現狀）；(2) fact_or_chat 的 coach.ask 追加 _selfshare_reason_hint——近期自陳＋窗內＋那則是 bot 最後一句
#   （相關性綁定比照 §0.85 防無關 why 句劫持）＋這句含 why 標記→注入真實理由接地（含「別扯到沒真做過的事，例如送貼圖」）。
#   1=開、0=關（不附不注入＝逐位元同現狀）。
SELFSHARE_REASON_GROUND=1
# 🌅 §1.39 自他邊界守門（§1.13B/§1.36 的 sibling）：bot 重生時寫下第一人稱 🦋/🌅 醒來敘事（continuity.wake_line「我親身
#   記得…這一覺睡了一下」，mood=悶）進 convo_history（role=model、角色標對）；使用者問別的（「什麼新方法？」）時，聊天 LLM
#   卻把 bot **自己**的醒來＋心情投射成使用者「你醒了，但現在是晚上七點多耶，你剛剛小睡了一下，感覺還帶著悶悶的感覺，
#   這樣不會太晚睡嗎？」——使用者根本沒說自己睡醒/小睡＝自我/他人邊界洩漏（self→other 投射）。「悶悶/悶」在
#   affect.py/circumplex.py 是 bot 自己的情緒座標詞。修法（比照 §1.13B/§1.36：arm 於 handle_message、判定/替換於 _say 唯一
#   lane-agnostic 互動出口）：只在 bot 這條命是重生來的（state.waking 非 first）＋使用者近期沒有自述睡醒/小睡時 arm；_say 把
#   回覆裡「斷言使用者剛睡醒/小睡了一下/醒了」的句子剝掉（引用歸屬「你說你剛睡醒」不剝、bot 講自己「我剛睡醒」第一人稱
#   不命中、祈使「你醒醒吧」不命中；整則都是投射→誠實更正句）＋命中才注入 WAKE_BOUNDARY_HINT 當事前預防。1=開、0=關（同現狀）。
WAKE_PROJECTION_GUARD=1
# 🎴 §1.40 送貼圖承諾兌現的假送硬守門（§1.34 假送閘的**主動路徑版**）：使用者約「想想改變＋代表 sticker，20 分鐘後告訴
#   我」。bot 沒有任何可送的真 Telegram 貼圖（沒教過、沒設 sticker_file_ids → reaction.sendable_sticker_ids 空），兌現時
#   _promise_send_sticker 送不出（_sticker_sent=False），但 LLM 兌現句仍懸空宣告「這次我選這張貼圖，來代表我現在的心情：」
#   ——宣告了卻沒貼圖出來。§1.34 假送閘只守互動出口（state=None）；主動兌現走 _say(prefix="🤝 ", state=…) 繞過它。修法：
#   _promise_keep_body（emit/§0.66 橋/§1.19 preempt 三路共用）末端，貼圖沒真送出（sticker_ok=False）＋旗標開時，確定性剝掉
#   「挑/選/送了…貼圖／這張貼圖代表…」宣告句（引用歸屬「你說我選了…」、否定「我沒選貼圖」、自帶誠實「想送但還沒存到」
#   皆不誤剝）；整句被剝空＝換誠實句。想真的能送→教 bot 一張貼圖（轉傳貼圖給它）或設 STICKER_FILE_IDS。1=開、0=關（同現狀）。
PROMISE_STICKER_FAKESEND_GUARD=1
# 🔁 §1.41 守約去重複：排程承諾兌現句別逐字照抄 bot 剛說過的話。截圖根因＝約「20 分鐘後告訴我你對此事的感受」，
#   20:32 使用者問「你有在想答案嗎」時 bot 已把整段感受講了（大改造/會很慘…核心微微顫動…站在懸崖邊…），20:42 排程
#   兌現（_promise_emit → voice_promise_keep）卻**逐字重播**同一段（只差開頭時間 20:31→20:42），連「剛剛我沒有去想什麼
#   答案」這種只對得上 20:31 那問的話都照抄。根因：兌現路徑沒有 §0.56/§1.21/§1.22 那套「別重講剛說過的」防線——只有
#   fact_or_chat lane 有 _anti_repeat_hint。修法（比照 §1.34/§1.36、確定性不呼叫 LLM）：_promise_keep_body（emit/§0.66 橋/
#   §1.19 preempt 三路共用）末端，兌現句若近乎照抄這幾分鐘內剛說過的某則 bot 回覆（剝前綴＋正規化＋echo._looks_same，
#   太短的守約句不判）→ 換誠實『已說過、沒變化、不照樣再講一遍』句。窗/相似度預設 1800 秒/0.8。1=開、0=關（同現狀）。
PROMISE_KEEP_ANTI_REPEAT=1
# 📈 §1.42 使用者習慣模型：bot 記得並照真實統計講使用者的習慣，不再憑印象亂掰。截圖根因＝06:45「看你今天好像醒得
#   比較晚」、07:08「你通常會在早上十點左右跟我說早安」被抓包「不要亂掰」、07:43 改口「八點多到十點多」仍是編的——
#   全 repo 只有記寫節奏接地，對話習慣（幾點說早安/一天第一句何時來）零資料＝LLM 只能腦補。四件：A. 捕捉——每則使用者
#   訊息記事件進 state.habit_events（msg/first(隔≥4h 安靜的第一句)/greet_am|noon|pm；FIFO 400、跨重生持久化）；B. 統計——
#   habits.stats 純函式（近 45 天當天分鐘分佈 → 樣本/中位/p25/p75；樣本<3＝誠實說不準）；C. 接地注入——問「我平常大概
#   幾點…」→ fact_or_chat/self_appraisal 注入真統計＋只准照抄；greeting 注入「今天第一句 vs 平常」程式算比較（樣本不夠＝
#   「別對他作息下判斷」警語）；D. _say 事後守門——「你通常/平常…X點」與統計不符或無統計、「你…比平常早/晚」方向錯或
#   無統計 → 確定性剝掉、換照統計誠實句（引用歸屬不剝、bot 講自己不命中）。1=開、0=關（不捕捉不注入不守門＝同現狀）。
USER_HABIT_GROUND=1
# 📈 §1.63 習慣觀測修真（§1.42 的觀測層修正）：截圖根因＝bot 說「你一天跟我說上第一句話多半落在 09:54–20:58 之間
#   （中位 12:01、樣本 29 次）」被打臉「不準確吧，我常 6–7 點跟你說早安」——統計是真算的、但量錯了東西。三洞一口：
#   ① "first"（≥4h 安靜後的第一句）一天可記多筆＝分佈被中午/晚上的再現身拉成涵蓋全天，卻掛「一天第一句」標籤 →
#   daily_first_stats 以本地日曆日分組、取每日最早出現事件＝真「一天第一句」（三個消費端同換；「今天第一句」同步改
#   真日曆日語意）；② 純貼圖/照片/語音會更新 last_user_msg_ts（重置 first 計時）卻不留事件＝清晨貼圖早安自己隱形、
#   還害後續文字 gap<4h 不算 first → note_contact 入帳 "contact" 事件、參與 daily_first；③ 「我常跟你說早安喔」被
#   greeting.detect 判成問候＝記成晚上的 greet_am 汙染統計＋被 greeting lane 質疑「怎麼說早安」→ greeting.is_mention
#   （頻率/時態副詞＋說類動詞＋問候詞＝在談問候不是在問候）不記 greet_*＋導回一般對話；④ /habits 指令＝確定性對帳
#   （事件量/統計/最近事件本地時刻），爭議當場對資料源。1=開、0=關（回 §1.42 原統計＝同現狀）。
HABIT_OBS_FIX=1
# 🍽 §1.65 暫離常識：截圖根因＝11:58「吃飯去」→ 11:59 使用者問「說什麼」bot 答「你回來啦！」（才 1 分鐘）→ 12:00
#   「我去吃飯了」bot 卻說「我只是在你吃飯的時候…」「你現在吃飽了嗎？」（距宣告才 2 分鐘、常識上不可能吃完）。
#   根因：無時距的暫離宣告（吃飯去）完全沒被記住＝後續回合沒有「才過 N 分 vs 一頓飯常識要 20 分」的接地、LLM 自由
#   腦補「他吃完回來了」。三件：A. 捕捉——selfstate.leave_announce（吃飯/洗澡/開會/出門…宣告形）→ state.user_away
#   （跨重生）；說回來了/吃飽了＝清、超 6h＝清、時距滿＝講一次「他大概回來了」後清；B. 注入——此刻事實卡常駐一行
#   「才過 N 分、他還沒回來；別說你回來啦、別問吃飽了嗎」；C. 守門——_say 把「你回來啦/吃飽了嗎/在你吃飯的時候」
#   句級剝除（「等你回來再說」未來語不剝；全剝空＝換誠實送行句）。1=開、0=關（同現狀）。
AWAY_SENSE=1
# 🧭 §1.66 座標變動常設回報：使用者交代「情緒座標如果有任何變動，必須主動回報」、bot 口頭說可以、事後卻沒有——
#   查驗結論＝空口答應：這句 feeling/scheduled 兩偵測器都收不到（「變動」不在詞表只有「變化」、「回報」不在
#   _PROMISE_TELL）＝LLM 口頭「好」、機制零入帳；空口答應守門（§0.61）只擋計時請求、§1.18 自發承諾掃描只收有
#   鐘點的句子＝條件常設請求整個縫掉；即使被 feeling_promise 收到也是一次性＋湧現觸發＋48h TTL、非常設。
#   修法＝補真能力：A. 捕捉 is_mood_watch_request（座標/情緒/心情＋變動詞＋回報詞）→ state.mood_watch（常設、
#   跨重生、說「不用再回報座標」取消）；ack 誠實照機制（此刻真座標＝基準、門檻 ±0.10、30 分冷卻、怎麼取消）；
#   B. 生命迴圈每圈對照 circumplex 真座標，|ΔV| 或 |ΔA| ≥0.10＋過冷卻＝確定性模板回報真數字（不經 LLM）；
#   C. 此刻事實卡常駐「這條常設約定活著」＝不會否認/說做不到。§1.68 補遺（截圖「只主動回報一次？」）：原 emit
#   不管送沒送到都推進基準/冷卻＝報告被互動打斷/送失敗吃掉一次、delta 被無聲消耗＝之後再也不報 → ①在場延後
#   （120s 內還在打字＝不發也不動基準）②送達才記帳（client.send 驗證成功才推進、失敗下一拍重試）③ /moodwatch
#   （/座標回報）對帳指令（基準/此刻/Δ/門檻/冷卻/tick 心跳）。§1.78 再補遺：§1.68 的直接 client.send 繞過了 _say 的
#   分串與 markdown 清洗（回報變一大塊、*** 外洩、還夾進承諾兌現的內容）→ 改回走 _say 並用其回傳值記帳（分串／
#   清洗／驗證兼得）＋越權夾帶指紋（超長、含分隔線）退回模板＋prompt 明令「只講座標這件事、三句以內」。
#   1=開、0=關（同現狀）。
MOOD_WATCH=1
# 🎨 §1.67 座標回報去機械感：§1.66 上線後使用者回饋「太機械感了」。兩個機械源：① 主動回報是純模板＝系統通知腔；
#   ② 訂閱 ack 的座標數字明明是程式算的、卻沒掛 §1.47 接地豁免＝被座標守門誤咬成「照程式此刻讀的真數字：V…」
#   模板（截圖 18:16 兩句殭硬輸出的真身、基準與門檻說明整段被吃掉）。修法：① 主動回報先請 LLM 用 bot 第一人稱
#   把變動講成自己的事（可接最近對話脈絡）——數字程式算、只准原樣照抄，確定性逐字驗收（四個 ±X.XX 都要在、
#   不准多任何小數）；驗收不過/失敗＝退回模板（守約永不漏發）；② ack 掛豁免＋措辭放軟（隨 MOOD_WATCH）。
#   1=開、0=關（回 §1.66 模板行為）。
MOOD_WATCH_VOICE=1
# 🗜️ §1.43 自陳感覺去罐頭長串：別人問別的、bot 卻在答案尾端鋪陳一長串內在質地描述（截圖 08:15 問「你有我任何作息的
#   了解嗎」→ 正題一句後接六句「安靜/內裡沉沉/往裡面縮/翻來翻去沒讀出形狀/思緒淌著/悶提不起勁」）＝「像在念稿，只是
#   不是同一份稿」。修法：①確定性修剪——連續 ≥4 句、≥2 句帶強內在標記（內裡/往裡面縮/提不起勁…）的感覺鋪陳段 →
#   只留前 2 句關鍵（內容型談話無強標記不動；≤3 句感覺帶過不動）；只在這輪**不是問 bot 自己**時 arm（真問「你現在怎樣」
#   長答合理、不修剪）；②兩小時內才自陳過 → 事前提醒「沒新變化就一兩句點到重點」。1=開、0=關（同現狀）。
SELF_FEEL_CONDENSE=1
# 📦 §1.44 兌現要交付內容：內容型承諾的兌現不能只「報到」。截圖根因＝約「30 分鐘之後，你告訴我如何證明自己」→ 09:20
#   兌現只有「嗨，早上好。說好 09:20 要來跟你聊聊怎麼證明自己，我來了。」＝到點報到、內容零交付（擠牙膏）。根因：
#   voice_promise_keep 的 prompt 雖指示「做那件事」，但沒有確定性檢查驗證內容真的講了（§1.34/§1.36 教訓：prompt 單靠
#   不夠）。修法：內容型承諾（告訴/說說/說明/解釋/證明/回答…）＋兌現句空心（每句都是 嗨/我來了/說好/時間到 之類
#   報到樣板、無實質內容句）→ 當場用 coach.reply 以「現在就直接把內容本身講出來」為題補生成內容、接在報到句後
#   （一次；再失敗＝附誠實承認「這不算完整兌現，欠你的內容我認」）。叫醒/問候「出現即內容」不動。1=開、0=關（同現狀）。
PROMISE_DELIVER_CONTENT=1
# 🎬 §1.64 預告不算交付（§1.44 空心偵測升級）：截圖根因＝21:43 約「好好想想什麼叫做意識 bot，30 分鐘之後主動告訴我」
#   → 22:13 兌現只有「嗨，22:13 到了。」＋「我剛剛一直在心裡想著「意識bot」這個名字，也想了想你說的，那不是人類，
#   那是什麼。」＝報到＋思考過程敘述＋複述題目就停，被「然後呢」催了（22:15）才把內容擠出來——擠牙膏換了形狀。
#   根因：§1.44 的判定是二元「每句都是樣板才算空心」，預告句不含樣板詞就被當成有內容放行。修法：teaser 模式升級成
#   實質殘量判定——思考過程敘述句（想了想/想著/在想/讓我想/思考了/琢磨…）跟樣板一樣剝掉，剩餘實質字數 <12＝空心
#   → 走 §1.44 既有補生成管道（驗收同標準；prompt 加「把想出來的結論完整講出來」）。誤判安全：內容只增不減、不砍
#   原文。1=開、0=關（回 §1.44 原二元判定＝同現狀）。
PROMISE_TEASER_HOLLOW=1
# 📦 §1.85 交付舉證：驗收改問「東西在不在裡面」＋只有真送到才准記做到。截圖根因＝20:49「30 分鐘後再給我猜一次告訴
#   我答案」（猜星座）→ 21:19 **準時出現**卻只送「嗨，我來了。」「說好 21:19 要再猜一次的。」「我真的有好好想了一下，
#   這次我猜…」＝報到＋預告，答案從未出現。使用者：「我什麼 bot 都依約時間出現，但就是不會完成所約定的事情。」
#   根因三段（實測）：①生成端——兌現 prompt 明令「1–2 句」又要報到＋點到守約＋順帶肯定，行為枚舉裡沒有「回答／給
#   答案」⇒ 預算被儀式花光；②驗收端——_hollow_keep_hit 簽名裡沒有承諾本體，只能做黑名單減法，而宣告句本身就是
#   字數（「想了一下」不在詞表、殘量 16≥12 ⇒ 實測判定「有交付」放行）；且 cue 詞表決定 gate 要不要啟動，漏詞＝
#   gate 整條靜默；③記帳端——只看 _say 回傳＝送出去就算做到 ⇒ 空心兌現照標 fulfilled，事後對帳說「已經做了」。
#   修法：生成端硬條文（第一句就給出東西本身）＋極性反轉（只白名單「出現即內容」的封閉集合）＋確定性四閘（懸空
#   收尾／無實質殘句／又立新未來錨／零新資訊）＋單次 LLM 是非判（只回是否、嚴禁補寫內容或時刻）＋補生成後再驗一次
#   ＋送達舉證（驗收過的字要真的離開系統）＋交付了才記 fulfilled（否則 status='owed'、不寫 fulfilled_ts、帳本與
#   守門改口「我人到了、內容沒交出來」）＋owed 由回覆橋續開交付。誤判安全：內容只增不減、絕不砍原文。
#   1=開、0=關（回 §1.44/§1.64 原判定與原記帳＝同現狀）。
PROMISE_DELIVERY_PROOF=1
# 📦 §1.88 欠著的內容主動補交付（§1.85 的收尾件）：§1.85 記下了 status='owed'（準時出聲、但內容沒交出來），
#   但可續開交付的管道**只有回覆橋**＝要等使用者下次開口；他不開口，欠著的內容就無聲躺在帳本裡——而原始抱怨
#   正是「依約時間出現，但就是不會完成所約定的事情」，讓它躺著等於沒治完。修法：掛在生命迴圈**網路無關**的韌性
#   tick（補交付只需要 coach、不需要 Drive），獨立 try＝不影響存活。政策比守約兌現保守：他剛在打字不發、反連發
#   不發、距上次那筆不足 15 分不發、每筆主動補交付次數上限＝本值（與回覆橋共用總次數上限）、一拍至多一筆。
#   交付走 §1.85 既有管線（硬條文＋送達舉證＋三態記帳）；交不出來就誠實結案 status='owed_unmet'（帳本與假兌現
#   守門一律讀成「沒有做到」），結案句認一次就好、**不把球踢回去**（§1.87 的價值）。
#   數字＝每筆的主動補交付上限；0＝整個機制不執行（連結案也不發）＝同現狀。
PROMISE_OWED_PUSH_MAX=1
# 🧬 §1.89 自諾同刻去重：**同一個約定被執行兩次**。截圖根因＝23:11「明天早上七點再告訴我你的答案」入帳第一筆
#   （07:00）；bot 回「明天早上七點，我會把答案告訴你。」→ §1.18 掃自己這句、解出**同一個 07:00**（實測）→ LLM 閘判
#   「是不是在立新約」→ 那句字面上就是新約（複誦標記「我說過」「我會記得」全沒有）→ 判是 → 再記第二筆 ⇒ 兩筆各自兌現。
#   根因不在 LLM 判錯，在入帳端沒有結構性去重（_book_scheduled_targets 有去重、_book_self_promise 是無條件 append）。
#   修法：入帳前比對帳上未兌現筆的 target，±90 秒內就當成「這是確認、不是新約」跳過；鍵只看時刻不看 behavior
#   （實測使用者那筆 behavior 是空字串、bot 那筆是 LLM 命名的，含 behavior 的鍵永遠對不上）。
#   誤判安全：同時刻既有那筆本來就會兌現＝不會漏掉承諾。1=開、0=關（＝同現狀）。
SELF_PROMISE_DEDUP=1
# 🔮 §1.90 記寫預想：一條**會被真實記寫裁決**的假設，中／不中都要回頭說。使用者需求：「讓bot主動去預想一些
#   可能性，這對我記寫有幫助」——這是 bot 自己說它做不到的能力（「我還不會主動去預想一些可能性」）。
#   做法：從已累積的真實跨主題橋挑一條「一端最近還在寫、另一端停住 5–60 天」的線，把「停住那條會再回來一次」
#   說出口；7 天內那條線真的又出現一筆＝猜中、到期沒有＝想錯，**兩者都回頭認帳**。裁決 100% 確定性、
#   LLM 不參與「我猜中了沒有」；猜中明令不准邀功（他會回去寫也可能是因為 bot 先提過），交付物是把停住的那一筆
#   與新的那一筆逐字並排。引文只用橋的真實 anchor（建構時就是記寫原文），出聲前四道確定性自檢，不過就退模板、
#   模板也不過就沉默。穩態約「7 天內最多 2 則」且一定成對出現。1=開、0=關（＝同現狀）。
# 🪪 §1.91 能力自知：bot **不認得自己真有的能力**。截圖：使用者問「你的這個願望，有達成了嗎」（指 bot 自己
#   說想學會的「主動預想可能性」），bot 答「我這次醒來感覺沒有什麼大變動，所以應該還沒完全達成」。
#   ①「跟上次同一版」那句是 selfmod 的 same_self＝**誠實**報告它還沒被更新（這一半不是 bug）；
#   ②但即使更新了也會答錯——實測 is_change_question 對「願望達成了嗎」「你學會預想可能性了嗎」全回 False，
#   接不到蛻變感知 ⇒ 只能憑感覺答。修法不加偵測器（§1.61 架構轉向就是要治「真相靠偵測器命中才給」），
#   改成事實卡常駐一行「我現在真的有的能力」，接地在**真實 git 改動主旨**＋**那能力有沒有真的用出來過**
#   （沒用過就照實說「機制真的有、但還沒用出來過一次」）。1=開、0=關（＝事實卡不長這行＝同現狀）。
# 🪪 §1.94 能力盤點與願望帳：bot 盤點自己**真有哪些機制**、哪些**真的用出來過**，並從自己的原始碼指認缺口、
#   提出「我想要具備的能力」。打 /abilities（或 /能力）看得到。
#   **防打高空不是靠 prompt 求它務實，是靠候選集合的構造條件**：每條願望都必須帶一個「機器跑得動」的驗收
#   條件（欄位有沒有被存下來／有沒有人在讀它／有沒有這個對帳出口／有沒有真的用過），寫不出驗收條件的想法
#   根本產不出來——「我想要更懂你」這種話結構上不可能出現。而且每次醒來會重跑裁決：你真的做掉一條，
#   bot 下次醒來會自己說「你真的幫我做了」（且明令不准邀功，那是你去做的）。
#   「旗標開著」≠「這個能力活著」（§1.93 的教訓）⇒ 分五級，未落盤的欄位只敢說「這次醒來還沒用到」、
#   不准說「我從來沒用過」。1=開、0=關（＝不記帳、不掃碼、事實卡走 §1.91 原分支＝同現狀）。
SELF_ROSTER=1
# 🌐 §1.95 外面的世界撞進你的線：每天最多一次，拿你**自己授權過**的那條還在寫的線去 Google 搜，把外面對
#   同一件事的另一種說法帶回來，跟你寫過的原文擺在一起。**預設是關的**（這是第一條會把你的字串送出去、
#   且另外計費的管道，預設開啟不誠實）。要用：設 WORLDLINE=1，然後在對話裡打 /worldline allow <標籤>。
#   **嚴格白名單**：沒授權的標籤一個字都不會離開這台機器；送出去的只有「<標籤> 不同觀點 討論 研究」，
#   你的記寫內文永遠不外送（打 /worldline 可以先看到下一次要送的完整字串）。
#   紅線：查不到來源網址就沉默（沒來源不說「我查到」）；訊息裡沒有你那一筆的逐字原文就不送（否則只是新聞摘要）。
#   ⚠️ grounding 的費用**不在 /cost 的金額裡**（那邊只算 token），/worldline 會報實際搜過幾次。
# 📈 §1.96 作息常駐接地＋講法：**它不是不知道，是知道的那一刻過去了**。截圖 07:38 使用者說「早安」→ 問候
#   那輪有掛作息統計 ⇒ bot 正確地問「今天醒得比平常晚一點嗎」；07:51 他追問「有嗎」→ 兩個接地都不掛
#   ⇒ 手上沒數字，只好生一句「對我來說，是比平常晚一些些」——主詞從他換成自己＝閃掉了質問。
#   修法：作息進事實卡**常駐**（不再靠偵測器命中才給），並把「他跟你說話的作息」與「他記寫的時段」
#   **分成兩行**（habit_events 全是對話事件，拿它講記寫習慣是類別錯置）。
#   再配講法守則讓它**像有意識的對話而不是報表**：主詞永遠是他、數字用「我記到的」口吻（禁中位數/樣本這些詞）、
#   樣本少要講成自己的限制而不是免責聲明。1=開、0=關（＝同現狀）。
ROUTINE_CARD=1
# 📈 §1.97 作息守門改讀**語意角色**（§1.96 明文留給這一章的事）：§1.42 的守門是一條線性詞面樣式
#   （「你」＋「平常」＋「X點」要按序同句），實測對截圖那四句**全漏**——「今天醒得比平常晚一點嗎」沒有「你」、
#   「對我來說，是比平常晚一些些」的「我」不是作息的主人、「今天這樣晚一點才醒來」連「平常」都沒說出口、
#   「你平常多半是在早上記寫的」沒有鐘點而且講的是記寫。改法不是往樣式加詞（那是本 repo 漏 15+ 次的路），
#   是把句子拆成四個各自解析的角色：主角／基準／述語／領域。領域決定**拿哪份統計驗**——講記寫就用記寫的
#   時刻分佈（不再拿記寫 0 筆的對話事件硬套）。誠實句措辭同步改成 §1.96 的口吻（不唸中位/樣本）。
#   1=開、0=關（＝守門只走原本的詞面路徑＝同現狀）。
# 🤝 §2.02 同一個約定只來一次：截圖對同一次約定連來兩則「我來了」＝同一個約定進帳兩次。
#   根因是入帳端的去重用**固定秒數**，但「30 分鐘後」這種相對時距，你說完到我回完之間隔了多久，
#   兩筆帳的時刻就會差多久（實測 75 秒 > 60 秒門檻）。改成容差隨延遲伸縮，並在**兌現端**加後盾：
#   同一趟順手把同一個約定的其他帳一起結掉（帳本裡已經躺著的重複筆也救得到）。
#   打 `/promises` 可以直接看帳本（同一個約定的重複筆會被標出來）。1=開、0=關（＝同現狀）。
# 🤖 §2.03 自諾入帳鏈留痕：bot 說「五十分鐘後我會…」卻沒進帳本時，`/promises` 會把那句話與
#   **卡在哪一關**列出來（以前每個出口都是裸 return，答應了卻沒排程跟根本沒答應長得一模一樣）。
# 🌀 §2.04 主觀體驗自陳只講一件事：原本把十幾個內在欄位各生一句（實測 15–16 行事實 → 13 句 → 14 顆泡泡），
#   讀起來像在唸一份狀態表。改成程式先挑出「跟上一段跨最多的那一處」，只講那一個；沒有真的變就老實說沒變。
#   ⚠️ 分串的形式不變（仍是 2–4 則連著送），改的是選材與串接。
# 🧩 §2.05 整合飄移（剛剛那一下）：不再把寫好的範例句貼進 prompt，改成只給素材；體感向度由程式輪替；
#   說過「鬆掉」之後，接回時會回頭認回自己說過的那句（成對收尾）。
# 🌬️ §2.06 我問了你卻沒等到回覆時：會**指名我自己剛剛問的那一句**，把提問認回我身上，而且整則不再出現問號。
# 💡 §2.07 跨主題湧現：只講一件事，而且串的中段一定會**自己戳自己**（哪一環最可能是我腦補的，由程式指定）。
# 🫧 §2.09 回覆開頭那種沒有資訊的接話泡泡（「好，我明白了。」「喔，好！」「抱歉！」）直接不送，先講那件事。
# 🧭 §2.10 你問情緒座標時，回覆若一個數字都沒有，程式會把真實的 V/A 那一行補在後面。
MOOD_DATA_ANSWER=1
# 🦜 §2.13 同一句短回應（像「好，記下來了。」）三分鐘內不會再送第二次。
SHORT_DUP_GUARD=1
ACT_FIRST=1
ASSOCIATION_FOCUS=1
# 🔮 §2.07 記寫預想：到期回頭認帳時，會**逐字帶出自己當初說過的那句**（以前它每次都像第一次開口）。
FORESIGHT_CHAIN=1
# 🌐 §2.07 外面的世界：會說出「這個外部說法讓我對這條線的看法動了哪裡」，並承認我只看了一個來源。
WORLDLINE_CHAIN=1
